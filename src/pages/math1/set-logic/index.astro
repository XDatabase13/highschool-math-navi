---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareSetLogicEntry } from '../../../utils/prepareSetLogicEntry';
import { buildSetLogicCenterItems } from '../../../utils/setLogicDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';
import { getTypeNavItems } from '../../../utils/typePages';

// 集合と論証 単元トップ。既存の共通3ペインDB UI（ProblemDbShell + Quadratic27Detail）を
// QF/TR/DA/ECとそのまま共有する。他単元と同格の公開contract（index対象・sitemap掲載・
// canonicalは自身のURL）とする。
const setLogic = (await getVerifiedCollection('setLogic')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildSetLogicCenterItems(setLogic);
const defaultEntry = setLogic[0];
const prepared = await prepareSetLogicEntry(defaultEntry);
// 中央列の「問題タイプ」一覧（初期タブは問題一覧。公開前は0件で切替自体を出さない）。
const typeItems = await getTypeNavItems('set-logic');
---

<ProblemDbShell
  title="数学I 集合と論証 | 高校数学ナビ"
  description="数学I「集合と論証」の問題データベースです。集合の表し方・共通部分・和集合・補集合から、命題の真偽、必要条件・十分条件、逆・裏・対偶、背理法まで、全18問を収録しています。"
  canonicalPath="/math1/set-logic/"
  breadcrumbItems={[{ label: '数学I' }, { label: '集合と論証' }]}
  activeUnitId="set-logic"
  activeItemId={defaultEntry.id}
  centerItems={centerItems}
  typeItems={typeItems}
>
  <Quadratic27Detail prepared={prepared} unitHeading="数学I 集合と論証" />
</ProblemDbShell>
