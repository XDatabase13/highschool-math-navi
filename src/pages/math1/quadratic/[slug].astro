---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareQuadratic27Entry } from '../../../utils/prepareQuadratic27Entry';
import { buildQuadraticCenterItems } from '../../../utils/quadraticDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';
import TypePageDetail from '../../../components/TypePageDetail.astro';
import type { CollectionEntry } from 'astro:content';
import {
  buildTypePageView,
  getTypeNavItems,
  getTypePageRoutes,
  typePageShellProps,
} from '../../../utils/typePages';

// 個別問題URL（/math1/quadratic/M1-QF-xxx/）は、静的生成された独立したHTMLページとして、
// その問題固有のtitle/description/本文を持つ。表示UIは/app/・単元トップと共通の
// ProblemDbShell + Quadratic27Detailを再利用し、「1問題=1固有URL」かつ
// 「表示UI=共通の3ペインDB」の両方を成立させる。
//
// 型ページ（/math1/quadratic/{型slug}/）も同じURL階層のため、別の動的routeは作らず、
// ここでproblem/typeのunionを返す（型routeは公開ゲート通過後のpublished全件だけ。
// 公開前のproduction buildでは0件で、既存の問題routeだけが生成される）。
export async function getStaticPaths() {
  const problems = await getVerifiedCollection('quadratic27');
  const typeRoutes = await getTypePageRoutes('quadratic', problems.map((problem) => problem.id));
  return [
    ...problems.map((problem) => ({
      params: { slug: problem.id },
      props: { kind: 'problem' as const, problem },
    })),
    ...typeRoutes.map((route) => ({
      params: { slug: route.slug },
      props: { kind: 'type' as const, typePageId: route.id },
    })),
  ];
}

type Props =
  | { kind: 'problem'; problem: CollectionEntry<'quadratic27'> }
  | { kind: 'type'; typePageId: string };

const props = Astro.props;
const problem = props.kind === 'problem' ? props.problem : undefined;
const prepared = problem ? await prepareQuadratic27Entry(problem) : undefined;
const typeView = props.kind === 'type' ? await buildTypePageView(props.typePageId) : undefined;

const allProblems = (await getVerifiedCollection('quadratic27')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildQuadraticCenterItems(allProblems);
const typeItems = await getTypeNavItems('quadratic');
---

{typeView ? (
  <ProblemDbShell
    {...typePageShellProps(typeView)}
    activeUnitId="quadratic"
    centerItems={centerItems}
    typeItems={typeItems}
    activeListView="types"
    activeTypeId={typeView.id}
    detailLabel="選択中の問題タイプ"
  >
    <TypePageDetail view={typeView} />
  </ProblemDbShell>
) : (
  problem &&
  prepared && (
    <ProblemDbShell
      title={`${problem.data.title} | 数学I 二次関数 | 高校数学ナビ`}
      description={`${problem.data.title}（重要度：${problem.data.importance_label}／難易度：${problem.data.difficulty}）。数学I「二次関数」の問題データベースより、問題文・ThinkingFlow・最終解答を確認できます。`}
      canonicalPath={`/math1/quadratic/${problem.id}/`}
      breadcrumbItems={[
        { label: '数学I' },
        { label: '二次関数', href: '/math1/quadratic/' },
        { label: problem.data.title },
      ]}
      activeUnitId="quadratic"
      activeItemId={problem.id}
      centerItems={centerItems}
      typeItems={typeItems}
    >
      <Quadratic27Detail prepared={prepared} />
    </ProblemDbShell>
  )
)}
