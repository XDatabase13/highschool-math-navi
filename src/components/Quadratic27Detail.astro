---
import { starRating } from '../utils/stars';
import { flowAssetKey, parseStepTitle, verifyStepNumberMatchesIndex } from '../utils/prepareQuadratic27Entry';
import type { MarkdownSection } from '../utils/markdownSections';

// PropsはPreparedQuadratic27Entryの具体型ではなく、実際にテンプレート内で使う
// フィールドだけの構造的な型にしてある（entry.data.assetsの詳細やcollection名には
// 依存しない）。prepared.entryの実体がquadratic27由来かどうかをこのコンポーネントは
// 判定しないため、同じ構造を満たす他コレクション（trig4試験バッチ等）の
// prepared結果もそのまま渡せる。JSX・CSS・スクリプトのロジックは変更していない。
interface DetailAssetEntry {
  svg: string;
  // typeは「密な全表を開閉式にする／複数assetを横並びにする」といった、
  // asset種別に応じた表示分岐にだけ使う（数式や本文の解析には使わない）。
  asset: { type: string };
}

interface Props {
  prepared: {
    entry: {
      data: {
        problem_id: string;
        title: string;
        importance_label: string;
        difficulty: number;
      };
    };
    problem: MarkdownSection | undefined;
    paraphrase: MarkdownSection | undefined;
    problemMeta: MarkdownSection | undefined;
    solutionMeta: MarkdownSection | undefined;
    thinkingFlow: MarkdownSection | undefined;
    finalAnswer: MarkdownSection | undefined;
    problemAssets: DetailAssetEntry[];
    finalAnswerAssets: DetailAssetEntry[];
    flowAssetsByKey: Map<string, DetailAssetEntry[]>;
  };
}

const { prepared } = Astro.props;
const { entry, problem, paraphrase, problemMeta, solutionMeta, thinkingFlow, finalAnswer, problemAssets, finalAnswerAssets, flowAssetsByKey } = prepared;

// ThinkingFlowの表示順に振る通し番号（"f1","f2",...）。AI-context JSON側
// （src/utils/aiContext.ts）のcontext_keyと同じ「part/flowに関係なく表示順で採番」
// というルールで、DOM側にも非視覚属性data-context-keyとして付与する。
// 通常Flow・小問付きFlowのどちらも、このコンポーネント内で1回だけ順にレンダリングされる
// ため、単純なクロージャ変数のインクリメントで表示順と一致させられる。
let contextKeyCounter = 0;
function nextContextKey(): string {
  contextKeyCounter += 1;
  return `f${contextKeyCounter}`;
}
---

<div class="q27-detail" data-problem-id={entry.data.problem_id}>
<h1>{entry.data.title}</h1>

<ul class="label-list">
  <li class="label-item">
    <span class="label-name">重要度</span>
    <span class="label-value">{entry.data.importance_label}</span>
  </li>
  <li class="label-item">
    <span class="label-name">難易度</span>
    <span class="label-value">{starRating(entry.data.difficulty, 4)}</span>
  </li>
</ul>

{problem && (
  <section class="problem-section">
    <h2>問題</h2>
    <div set:html={problem.html} />
    {problem.subsections.length > 0 && (
      <div class="problem-parts">
        {problem.subsections.map((part) => (
          <div class="problem-part">
            <h3 class="problem-part-label">{part.title}</h3>
            <div set:html={part.html} />
          </div>
        ))}
      </div>
    )}
    {problemAssets.length > 1 ? (
      // asset.type==='table'（密な全表）だけ開閉式＋横幅拡大にし、それ以外は
      // 通常のfigureのまま。複数asset（現状M1-TR-003の図+抜粋表のみ）だけ
      // 横並び用コンテナで包む。既存54問はproblemAssetsが0〜1件のためこの分岐に入らない。
      <div class="problem-asset-row">
        {problemAssets.map(({ asset, svg }) =>
          asset.type === 'table' ? (
            <details class="problem-asset-collapsible">
              <summary class="problem-asset-collapsible-toggle">表を見る</summary>
              <div class="problem-asset-figure problem-asset-table-scroll" set:html={svg} />
            </details>
          ) : (
            <figure class="problem-asset-figure" set:html={svg} />
          ),
        )}
      </div>
    ) : (
      problemAssets.map(({ asset, svg }) =>
        asset.type === 'table' ? (
          <details class="problem-asset-collapsible">
            <summary class="problem-asset-collapsible-toggle">表を見る</summary>
            <div class="problem-asset-figure problem-asset-table-scroll" set:html={svg} />
          </details>
        ) : (
          <figure class="problem-asset-figure" set:html={svg} />
        ),
      )
    )}
    {paraphrase && (
      <div class="paraphrase-box">
        <button type="button" class="paraphrase-toggle" data-paraphrase-toggle>
          言い換えを見る
        </button>
        <div class="paraphrase-content" data-paraphrase-content hidden>
          {paraphrase.subsections.length === 0 ? (
            <div set:html={paraphrase.html} />
          ) : (
            paraphrase.subsections.map((part) => (
              <div class="paraphrase-part">
                <h4 class="paraphrase-part-label">{part.title}</h4>
                <div set:html={part.html} />
              </div>
            ))
          )}
        </div>
      </div>
    )}
  </section>
)}

{(problemMeta || solutionMeta) && (
  <section class="impression-section">
    {problemMeta && (
      <div class="impression-block" data-impression-block>
        <h3 class="impression-subhead">
          <button type="button" class="impression-subhead-toggle" data-impression-toggle aria-expanded="false">
            <span>問題メタ</span>
            <span class="impression-caret" aria-hidden="true" />
          </button>
        </h3>
        <div class="impression-content" data-impression-content hidden>
          <div class="impression-content-inner" set:html={problemMeta.html} />
        </div>
      </div>
    )}
    {solutionMeta && (
      <div class="impression-block" data-impression-block>
        <h3 class="impression-subhead">
          <button type="button" class="impression-subhead-toggle" data-impression-toggle aria-expanded="false">
            <span>解法メタ</span>
            <span class="impression-caret" aria-hidden="true" />
          </button>
        </h3>
        <div class="impression-content" data-impression-content hidden>
          <div class="impression-content-inner" set:html={solutionMeta.html} />
        </div>
      </div>
    )}
  </section>
)}

{thinkingFlow && (
  <section class="thinking-section">
    <h2>ThinkingFlow</h2>
    {thinkingFlow.subsections.every((s) => s.subsections.length === 0) ? (
      // 通常Flow：見出しがそのまま末端ステップ
      // data-flow-kind="q27"：ThinkingFlow.astroの汎用スクリプトと二重に
      // click handlerが付かないよう、このコンポーネント専用スクリプトの対象を区別する。
      <div class="thinking-flow" data-flow-kind="q27">
        <button type="button" class="reveal-all-btn" data-reveal-all>
          考え方を全部見る
        </button>
        <ol class="thinking-steps">
          {thinkingFlow.subsections.map((step, index) => {
            verifyStepNumberMatchesIndex(entry.data.problem_id, '通常Flow', step.title, index + 1);
            const { displayTitle, highlighted } = parseStepTitle(step.title);
            const contextKey = nextContextKey();
            return (
              <li
                class:list={['thinking-step', highlighted && 'thinking-step--highlight']}
                data-step-index={index}
                data-context-key={contextKey}
              >
                <button type="button" class="thinking-step-header thinking-step-toggle" data-step-toggle aria-expanded="false">
                  <span class="thinking-step-label">{displayTitle}</span>
                  {highlighted && <span class="thinking-step-star" aria-hidden="true">★</span>}
                  <span class="thinking-step-caret" aria-hidden="true" />
                </button>
                <div class="thinking-step-content" data-step-content hidden>
                  <div class="thinking-step-content-inner">
                    <div class="thinking-step-body" set:html={step.html} />
                    {(flowAssetsByKey.get(flowAssetKey(undefined, index + 1)) ?? []).map(({ svg }) => (
                      <figure class="problem-asset-figure" set:html={svg} />
                    ))}
                    <div class="ai-ask" data-ai-ask>
                      <button type="button" class="ai-ask-btn" data-ai-ask-toggle aria-expanded="false">
                        AIに聞く
                      </button>
                      <div class="ai-ask-panel" data-ai-ask-panel hidden>
                        <div class="ai-ask-panel-inner">
                          <ul class="ai-ask-options">
                            <li>
                              <button type="button" class="ai-ask-option-btn" data-ai-ask-option="detail">
                                もう少し詳しく説明して
                              </button>
                            </li>
                            <li>
                              <button type="button" class="ai-ask-option-btn" data-ai-ask-option="knowledge">
                                ここで使っている知識を教えて
                              </button>
                            </li>
                            <li>
                              <button type="button" class="ai-ask-option-btn" data-ai-ask-option="custom">
                                自分で質問する
                              </button>
                            </li>
                          </ul>
                          <div class="ai-ask-custom" data-ai-ask-custom hidden>
                            <textarea class="ai-ask-input" data-ai-ask-input rows="2" placeholder="質問を入力"></textarea>
                            <button type="button" class="ai-ask-submit" data-ai-ask-submit>送信</button>
                          </div>
                          <p class="ai-ask-note" data-ai-ask-note hidden>AI接続は次工程で実装予定です。</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ) : (
      // 小問付きFlow：(1)/(2)ごとに独立した.thinking-flowを並べる。
      // part.title（###見出し）も、通常Flowのstep.titleと同じ形式（"1. ☆ ..."等）で
      // 強調マークが付くことがある（例：M1-TR-021の「1. ☆ ...」「補助Flow：...」構成）。
      // parseStepTitleは "(1)" のような小問番号見出しにはマッチせず素通りするだけなので、
      // ここでも同じ関数を通して☆マークを除去し★表示へ揃える（一致しない場合は無変化）。
      thinkingFlow.subsections.map((part) => {
        const { displayTitle: partDisplayTitle, highlighted: partHighlighted } = parseStepTitle(part.title);
        return (
        <div class="thinking-part">
          <h3 class="thinking-part-label">
            {partDisplayTitle}
            {partHighlighted && <span class="thinking-step-star" aria-hidden="true">★</span>}
          </h3>
          <div class="thinking-flow" data-flow-kind="q27">
            <button type="button" class="reveal-all-btn" data-reveal-all>
              考え方を全部見る
            </button>
            <ol class="thinking-steps">
              {part.subsections.map((step, index) => {
                verifyStepNumberMatchesIndex(
                  entry.data.problem_id,
                  `小問Flow ${part.title}`,
                  step.title,
                  index + 1,
                );
                const { displayTitle, highlighted } = parseStepTitle(step.title);
                const contextKey = nextContextKey();
                return (
                  <li
                    class:list={['thinking-step', highlighted && 'thinking-step--highlight']}
                    data-step-index={index}
                    data-context-key={contextKey}
                  >
                    <button type="button" class="thinking-step-header thinking-step-toggle" data-step-toggle aria-expanded="false">
                      <span class="thinking-step-label">{displayTitle}</span>
                      {highlighted && <span class="thinking-step-star" aria-hidden="true">★</span>}
                      <span class="thinking-step-caret" aria-hidden="true" />
                    </button>
                    <div class="thinking-step-content" data-step-content hidden>
                      <div class="thinking-step-content-inner">
                        <div class="thinking-step-body" set:html={step.html} />
                        {(flowAssetsByKey.get(flowAssetKey(part.partNumber, index + 1)) ?? []).map(({ svg }) => (
                          <figure class="problem-asset-figure" set:html={svg} />
                        ))}
                        <div class="ai-ask" data-ai-ask>
                          <button type="button" class="ai-ask-btn" data-ai-ask-toggle aria-expanded="false">
                            AIに聞く
                          </button>
                          <div class="ai-ask-panel" data-ai-ask-panel hidden>
                            <div class="ai-ask-panel-inner">
                              <ul class="ai-ask-options">
                                <li>
                                  <button type="button" class="ai-ask-option-btn" data-ai-ask-option="detail">
                                    もう少し詳しく説明して
                                  </button>
                                </li>
                                <li>
                                  <button type="button" class="ai-ask-option-btn" data-ai-ask-option="knowledge">
                                    ここで使っている知識を教えて
                                  </button>
                                </li>
                                <li>
                                  <button type="button" class="ai-ask-option-btn" data-ai-ask-option="custom">
                                    自分で質問する
                                  </button>
                                </li>
                              </ul>
                              <div class="ai-ask-custom" data-ai-ask-custom hidden>
                                <textarea class="ai-ask-input" data-ai-ask-input rows="2" placeholder="質問を入力"></textarea>
                                <button type="button" class="ai-ask-submit" data-ai-ask-submit>送信</button>
                              </div>
                              <p class="ai-ask-note" data-ai-ask-note hidden>AI接続は次工程で実装予定です。</p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        </div>
        );
      })
    )}
  </section>
)}

{finalAnswer && (
  <section class="final-answer-section">
    <h2>最終解答</h2>
    <button type="button" class="reveal-answer-btn" data-answer-toggle>
      解答を見る
    </button>
    <div class="result-box" data-answer-box hidden>
      <div class="result-box-inner">
        {finalAnswer.subsections.length === 0 ? (
          <div set:html={finalAnswer.html} />
        ) : (
          finalAnswer.subsections.map((part) => (
            <div class="final-answer-part">
              <h3 class="final-answer-part-label">{part.title}</h3>
              <div set:html={part.html} />
            </div>
          ))
        )}
        {finalAnswerAssets.map(({ svg }) => (
          <figure class="problem-asset-figure" set:html={svg} />
        ))}
      </div>
    </div>
  </section>
)}
</div>

<script>
  import renderMathInElement from 'katex/contrib/auto-render';

  // ThinkingFlow AI質問機能：全95問（QF/TR）共通で同じWorkerエンドポイントへ通信する。
  // 問題ごとの個別実装は持たず、data-problem-id・data-context-keyだけで対象を特定する。
  // 実際に受け付けるかどうか（対象のAI-context JSONが存在するか）の判定はWorker側で行う。
  //
  // 本番公開の準備が整うまでAI機能全体を一括で止められるよう、feature flagを2つの
  // 環境変数のANDで判定する。片方でも欠けていれば必ず無効側（実通信しない）に倒す。
  //   PUBLIC_AI_ENABLED=true かつ PUBLIC_AI_WORKER_URL設定済み → 有効
  //   それ以外（false／未設定、またはURL未設定） → 無効
  // URL側にフォールバック値があるのは「有効時にどのURLへ送るか」のためだけで、
  // フォールバックの存在自体が「設定済み」とはみなさない（生の環境変数の有無で判定する）。
  const AI_ENABLED = import.meta.env.PUBLIC_AI_ENABLED === 'true' && !!import.meta.env.PUBLIC_AI_WORKER_URL;
  const AI_WORKER_URL = import.meta.env.PUBLIC_AI_WORKER_URL || 'http://127.0.0.1:8787';
  const AI_DISABLED_MESSAGE = 'AI機能は現在準備中です。';

  type AiQuestionType = 'detail' | 'knowledge' | 'custom';

  function escapeHtml(text: string): string {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Gemini回答（プレーンテキスト＋簡易Markdown＋$...$/$$...$$のLaTeX）を、
  // 生HTMLとして無条件にinnerHTMLへ流さずに表示する。まずHTMLエスケープしてから、
  // 自前で許可した最低限の記法（**太字**、段落・改行）だけを安全なタグへ変換し、
  // 最後に既存サイトと同じKaTeX（katex/contrib/auto-render）で数式を描画する。
  //
  // 数式ブロックはGeminiが "$$\n...\n$$" のように内部に改行を含めて返すことが多い。
  // 段落・改行変換を先に行うと、その改行が<br>に変わって$$...$$の開始/終了が
  // 別々のテキストノードに分断され、auto-renderが検出できなくなる
  // （$$が生表示されたまま残る不具合の原因だった）。そのため数式部分を
  // 一時的なプレースホルダに退避し、段落・改行変換は数式の外側にだけ適用してから
  // 数式を元の生テキストのまま戻す。
  const MATH_SPAN_PATTERN = /\$\$[\s\S]+?\$\$|\$[^$]+?\$/g;

  function renderAiAnswerText(container: HTMLElement, rawText: string): void {
    const escaped = escapeHtml(rawText);
    const withBold = escaped.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

    const mathSpans: string[] = [];
    const placeholderPattern = (i: number) => `␀MATH${i}␀`;
    const withPlaceholders = withBold.replace(MATH_SPAN_PATTERN, (match) => {
      mathSpans.push(match);
      return placeholderPattern(mathSpans.length - 1);
    });

    const htmlWithPlaceholders = withPlaceholders
      .split(/\n{2,}/)
      .map((paragraph) => `<p>${paragraph.replace(/\n/g, '<br>')}</p>`)
      .join('');

    const html = htmlWithPlaceholders.replace(/␀MATH(\d+)␀/g, (_, i) => mathSpans[Number(i)]);

    container.innerHTML = html;
    renderMathInElement(container, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false },
      ],
      throwOnError: false,
    });
  }

  async function askAi(
    ask: HTMLElement,
    note: HTMLElement,
    problemId: string,
    contextKey: string,
    questionType: AiQuestionType,
    freeText: string | null,
  ): Promise<void> {
    // 通信中の二重送信だけ防ぎ、終了後（成功・失敗いずれも）は
    // 必ず全ボタンを再利用可能な状態へ戻す（finallyで解除）。
    if (ask.dataset.aiAskPending === 'true') return;
    ask.dataset.aiAskPending = 'true';
    const buttons = Array.from(ask.querySelectorAll<HTMLButtonElement>('.ai-ask-option-btn, .ai-ask-submit'));
    buttons.forEach((btn) => (btn.disabled = true));
    note.classList.add('ai-ask-answer');
    renderAiAnswerText(note, '考え中…');
    try {
      const res = await fetch(AI_WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          problem_id: problemId,
          context_key: contextKey,
          question_type: questionType,
          free_text: freeText,
        }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data || typeof data.answer !== 'string') {
        renderAiAnswerText(
          note,
          data && typeof data.error === 'string' ? data.error : 'AIからの回答取得に失敗しました。',
        );
        return;
      }
      renderAiAnswerText(note, data.answer);
    } catch {
      renderAiAnswerText(note, '通信に失敗しました。もう一度お試しください。');
    } finally {
      ask.dataset.aiAskPending = 'false';
      buttons.forEach((btn) => (btn.disabled = false));
    }
  }

  document.querySelectorAll<HTMLElement>('.thinking-flow[data-flow-kind="q27"]').forEach((flow) => {
    if (flow.dataset.q27Bound) return;
    flow.dataset.q27Bound = 'true';

    const problemId = flow.closest<HTMLElement>('.q27-detail')?.dataset.problemId ?? '';

    const stepEls = Array.from(flow.querySelectorAll<HTMLElement>('.thinking-step'));
    const revealAllBtn = flow.querySelector<HTMLButtonElement>('[data-reveal-all]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 閉じるアニメーション(CSS側は150〜200ms)が終わってからhiddenへ戻すための
    // 予約タイマー。連続操作で開閉し直された場合に備え、要素ごとに保持し
    // 前回分は必ずclearしてから次の状態へ進む。
    const closeTimers = new WeakMap<HTMLElement, number>();

    // 各Flowは題名のみの初期状態から独立して開閉できる。「考え方を全部見る」は
    // 全Flow展開⇔全Flow閉じるのトグルとして扱う。
    function setStepExpanded(stepEl: HTMLElement, expanded: boolean) {
      const toggle = stepEl.querySelector<HTMLButtonElement>('[data-step-toggle]');
      const content = stepEl.querySelector<HTMLElement>('[data-step-content]');
      if (toggle) toggle.setAttribute('aria-expanded', String(expanded));
      if (!content) return;

      const pendingTimer = closeTimers.get(content);
      if (pendingTimer !== undefined) {
        window.clearTimeout(pendingTimer);
        closeTimers.delete(content);
      }

      if (expanded) {
        content.hidden = false;
        if (prefersReducedMotion) {
          content.classList.add('is-open');
          return;
        }
        // hiddenを外した直後は:not([hidden])の初期値（0fr/opacity:0）。
        // レイアウトを一度強制確定させてからis-openを付けることで、
        // バックグラウンドタブ等でrequestAnimationFrameが遅延・停止する
        // 環境でも確実にトランジションの起点が反映される。
        void content.offsetHeight;
        content.classList.add('is-open');
      } else {
        content.classList.remove('is-open');
        if (prefersReducedMotion) {
          content.hidden = true;
          return;
        }
        // CSS側の最大想定（200ms）より少し余裕を持たせ、確実に収縮し終えてから
        // hiddenに戻す（開閉ロジック・最終状態自体は変更しない）。
        const timerId = window.setTimeout(() => {
          content.hidden = true;
          closeTimers.delete(content);
        }, 220);
        closeTimers.set(content, timerId);
      }
    }

    // 「AIに聞く」パネルの開閉も、ThinkingFlowの各STEPと同じgrid-template-rows
    // 0fr/1fr切り替えを再利用する（新しい開閉アニメーション実装を増やさない）。
    // 現段階ではUI試作のみで、外部AI APIへの通信は一切行わない。
    function setPanelExpanded(toggle: HTMLButtonElement, content: HTMLElement, expanded: boolean) {
      toggle.setAttribute('aria-expanded', String(expanded));

      const pendingTimer = closeTimers.get(content);
      if (pendingTimer !== undefined) {
        window.clearTimeout(pendingTimer);
        closeTimers.delete(content);
      }

      if (expanded) {
        content.hidden = false;
        if (prefersReducedMotion) {
          content.classList.add('is-open');
          return;
        }
        void content.offsetHeight;
        content.classList.add('is-open');
      } else {
        content.classList.remove('is-open');
        if (prefersReducedMotion) {
          content.hidden = true;
          return;
        }
        const timerId = window.setTimeout(() => {
          content.hidden = true;
          closeTimers.delete(content);
        }, 220);
        closeTimers.set(content, timerId);
      }
    }

    function updateRevealAllLabel() {
      if (!revealAllBtn) return;
      const allExpanded = stepEls.every((stepEl) => {
        const toggle = stepEl.querySelector<HTMLButtonElement>('[data-step-toggle]');
        return toggle ? toggle.getAttribute('aria-expanded') === 'true' : true;
      });
      revealAllBtn.textContent = allExpanded ? '考え方を閉じる' : '考え方を全部見る';
    }

    flow.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      const stepToggle = target.closest<HTMLButtonElement>('[data-step-toggle]');
      if (stepToggle) {
        const stepEl = stepToggle.closest<HTMLElement>('.thinking-step');
        if (stepEl) {
          const isExpanded = stepToggle.getAttribute('aria-expanded') === 'true';
          setStepExpanded(stepEl, !isExpanded);
          updateRevealAllLabel();
        }
        return;
      }

      const aiAskToggle = target.closest<HTMLButtonElement>('[data-ai-ask-toggle]');
      if (aiAskToggle) {
        const ask = aiAskToggle.closest<HTMLElement>('[data-ai-ask]');
        const panel = ask?.querySelector<HTMLElement>('[data-ai-ask-panel]');
        if (panel) {
          const isExpanded = aiAskToggle.getAttribute('aria-expanded') === 'true';
          const nextExpanded = !isExpanded;
          setPanelExpanded(aiAskToggle, panel, nextExpanded);
          aiAskToggle.textContent = nextExpanded ? 'AIを閉じる' : 'AIに聞く';

          // feature flagがOFFの間は、質問選択UI（3択・自由入力欄）は出さず、
          // 「準備中」の案内だけをそのFlow内に表示する。Worker通信には一切進まない。
          if (nextExpanded && !AI_ENABLED) {
            const options = ask?.querySelector<HTMLElement>('.ai-ask-options');
            const custom = ask?.querySelector<HTMLElement>('[data-ai-ask-custom]');
            const note = ask?.querySelector<HTMLElement>('[data-ai-ask-note]');
            options?.setAttribute('hidden', '');
            custom?.setAttribute('hidden', '');
            if (note) {
              note.classList.remove('ai-ask-answer');
              note.hidden = false;
              note.textContent = AI_DISABLED_MESSAGE;
            }
          }
        }
        return;
      }

      // 3択のうち「もう少し詳しく説明して」「ここで使っている知識を教えて」は、
      // 即座にWorkerへ実通信する（全95問共通。問題ごとの分岐は持たない）。
      const aiAskOption = target.closest<HTMLButtonElement>('[data-ai-ask-option]');
      if (aiAskOption) {
        const ask = aiAskOption.closest<HTMLElement>('[data-ai-ask]');
        const custom = ask?.querySelector<HTMLElement>('[data-ai-ask-custom]');
        const note = ask?.querySelector<HTMLElement>('[data-ai-ask-note]');
        const optionType = aiAskOption.dataset.aiAskOption;
        if (optionType === 'custom') {
          custom?.removeAttribute('hidden');
          note?.setAttribute('hidden', '');
        } else {
          custom?.setAttribute('hidden', '');
          if (note) note.hidden = false;

          if (AI_ENABLED && ask && note && (optionType === 'detail' || optionType === 'knowledge')) {
            const stepEl = aiAskOption.closest<HTMLElement>('.thinking-step');
            const contextKey = stepEl?.dataset.contextKey;
            if (contextKey) {
              void askAi(ask, note, problemId, contextKey, optionType, null);
            }
          }
        }
        return;
      }

      const aiAskSubmit = target.closest<HTMLButtonElement>('[data-ai-ask-submit]');
      if (aiAskSubmit) {
        const ask = aiAskSubmit.closest<HTMLElement>('[data-ai-ask]');
        const note = ask?.querySelector<HTMLElement>('[data-ai-ask-note]');
        if (note) note.hidden = false;

        // 「自分で質問する」はテキスト入力後の送信時だけ通信する
        // （選択肢クリック時点では送信しない）。
        if (AI_ENABLED && ask && note) {
          const stepEl = aiAskSubmit.closest<HTMLElement>('.thinking-step');
          const contextKey = stepEl?.dataset.contextKey;
          const textarea = ask.querySelector<HTMLTextAreaElement>('[data-ai-ask-input]');
          const freeText = textarea?.value.trim();
          if (contextKey && freeText) {
            void askAi(ask, note, problemId, contextKey, 'custom', freeText);
          }
        }
        return;
      }

      const revealBtn = target.closest<HTMLButtonElement>('[data-reveal-all]');
      if (revealBtn) {
        const allExpanded = stepEls.every((stepEl) => {
          const toggle = stepEl.querySelector<HTMLButtonElement>('[data-step-toggle]');
          return toggle ? toggle.getAttribute('aria-expanded') === 'true' : true;
        });
        stepEls.forEach((stepEl) => setStepExpanded(stepEl, !allExpanded));
        updateRevealAllLabel();
      }
    });

    updateRevealAllLabel();
  });

  // 最終解答の開閉も、ThinkingFlowの各STEPと同じ手法（grid-template-rowsの
  // 0fr/1fr切り替え）でアニメーションさせる。開閉ロジック・最終状態は変更しない。
  document.querySelectorAll<HTMLElement>('[data-answer-toggle]').forEach((btn) => {
    if (btn.dataset.answerBound) return;
    btn.dataset.answerBound = 'true';
    const box = btn.parentElement?.querySelector<HTMLElement>('[data-answer-box]');
    if (!box) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let closeTimer: number | undefined;

    btn.addEventListener('click', () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }

      const isHidden = box.hasAttribute('hidden');
      if (isHidden) {
        box.hidden = false;
        btn.textContent = '解答を隠す';
        if (prefersReducedMotion) {
          box.classList.add('is-open');
          return;
        }
        // hiddenを外した直後はCSS側の閉状態（0fr/opacity:0）。
        // 強制的にレイアウトを確定させてからis-openを付けることで
        // そこから滑らかにアニメーションする（rAFに頼らない）。
        void box.offsetHeight;
        box.classList.add('is-open');
      } else {
        box.classList.remove('is-open');
        btn.textContent = '解答を見る';
        if (prefersReducedMotion) {
          box.hidden = true;
          return;
        }
        // CSS側の閉アニメーション（150〜180ms）より少し余裕を持たせてからhiddenに戻す。
        closeTimer = window.setTimeout(() => {
          box.hidden = true;
          closeTimer = undefined;
        }, 200);
      }
    });
  });

  // 問題メタ／解法メタの開閉はスマホ幅だけの挙動（CSS側で制御）。
  // JS自体は常に付けておき、PCではCSSの上書きにより見た目・挙動が変わらない。
  // ThinkingFlow・最終解答と同じ「hidden解除→強制reflow→is-open付与」の
  // アニメーション手法を再利用する。
  document.querySelectorAll<HTMLElement>('[data-impression-toggle]').forEach((btn) => {
    if (btn.dataset.impressionBound) return;
    btn.dataset.impressionBound = 'true';
    const block = btn.closest<HTMLElement>('[data-impression-block]');
    const content = block?.querySelector<HTMLElement>('[data-impression-content]');
    if (!content) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let closeTimer: number | undefined;

    btn.addEventListener('click', () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }

      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      btn.setAttribute('aria-expanded', String(nextExpanded));

      if (nextExpanded) {
        content.hidden = false;
        if (prefersReducedMotion) {
          content.classList.add('is-open');
          return;
        }
        void content.offsetHeight;
        content.classList.add('is-open');
      } else {
        content.classList.remove('is-open');
        if (prefersReducedMotion) {
          content.hidden = true;
          return;
        }
        closeTimer = window.setTimeout(() => {
          content.hidden = true;
          closeTimer = undefined;
        }, 220);
      }
    });
  });

  document.querySelectorAll<HTMLElement>('[data-paraphrase-toggle]').forEach((btn) => {
    if (btn.dataset.paraphraseBound) return;
    btn.dataset.paraphraseBound = 'true';
    const box = btn.parentElement?.querySelector<HTMLElement>('[data-paraphrase-content]');
    btn.addEventListener('click', () => {
      const isHidden = box?.hasAttribute('hidden') ?? false;
      box?.toggleAttribute('hidden');
      btn.textContent = isHidden ? '言い換えを閉じる' : '言い換えを見る';
    });
  });
</script>
