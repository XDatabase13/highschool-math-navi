---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareExpressionCalculationEntry } from '../../../utils/prepareExpressionCalculationEntry';
import { buildExpressionCalculationCenterItems } from '../../../utils/expressionCalculationDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';
import TypePageDetail from '../../../components/TypePageDetail.astro';
import type { CollectionEntry } from 'astro:content';
import {
  buildTypePageView,
  getTypeNavItems,
  getTypePageRoutes,
  typePageShellProps,
} from '../../../utils/typePages';

// 数と式「式の計算」の個別問題ページ。/math1/data-analysis/[slug].astroと同じ構成
// （静的生成・共通DBシェル再利用）をexpressionCalculationコレクションに対しても使う。
// QF/TR/DAと同格の公開contract（index対象・sitemap掲載・canonicalは自身のURL）とする。
//
// 型ページ（/math1/suto-shiki/{型slug}/）も同じURL階層のため、別の動的routeは作らず、
// ここでproblem/typeのunionを返す（型routeは公開ゲート通過後のpublished全件だけ。
// 公開前のproduction buildでは0件で、既存の問題routeだけが生成される）。
export async function getStaticPaths() {
  const problems = await getVerifiedCollection('expressionCalculation');
  const typeRoutes = await getTypePageRoutes('suto-shiki', problems.map((problem) => problem.id));
  return [
    ...problems.map((problem) => ({
      params: { slug: problem.id },
      props: { kind: 'problem' as const, problem },
    })),
    ...typeRoutes.map((route) => ({
      params: { slug: route.slug },
      props: { kind: 'type' as const, typePageId: route.id },
    })),
  ];
}

type Props =
  | { kind: 'problem'; problem: CollectionEntry<'expressionCalculation'> }
  | { kind: 'type'; typePageId: string };

const props = Astro.props;
const problem = props.kind === 'problem' ? props.problem : undefined;
const prepared = problem ? await prepareExpressionCalculationEntry(problem) : undefined;
const typeView = props.kind === 'type' ? await buildTypePageView(props.typePageId) : undefined;

const allProblems = (await getVerifiedCollection('expressionCalculation')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildExpressionCalculationCenterItems(allProblems);
const typeItems = await getTypeNavItems('suto-shiki');
---

{typeView ? (
  <ProblemDbShell
    {...typePageShellProps(typeView)}
    activeUnitId="suto-shiki"
    centerItems={centerItems}
    typeItems={typeItems}
    activeListView="types"
    activeTypeId={typeView.id}
    detailLabel="選択中の問題タイプ"
  >
    <TypePageDetail view={typeView} />
  </ProblemDbShell>
) : (
  problem &&
  prepared && (
    <ProblemDbShell
      title={`${problem.data.title} | 数学I 数と式 | 高校数学ナビ`}
      description={`${problem.data.title}（重要度：${problem.data.importance_label}／難易度：${problem.data.difficulty}）。数学I「数と式」の問題データベースより、問題文・ThinkingFlow・最終解答を確認できます。`}
      canonicalPath={`/math1/suto-shiki/${problem.id}/`}
      breadcrumbItems={[
        { label: '数学I' },
        { label: '数と式', href: '/math1/suto-shiki/' },
        { label: problem.data.title },
      ]}
      activeUnitId="suto-shiki"
      activeItemId={problem.id}
      centerItems={centerItems}
      typeItems={typeItems}
    >
      <Quadratic27Detail prepared={prepared} />
    </ProblemDbShell>
  )
)}
