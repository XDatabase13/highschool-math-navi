---
import { displayProblemNumber, type DbCenterGroup } from '../utils/dbCenterList';

// PC中央列（ProblemDbShell.astro）とスマホ用の問題一覧ダイアログの両方から
// 同じマークアップ・同じCSSで使う「3区分アコーディオン＋行リスト」本体。
// 分類（どの問題がどの区分に属するか）はgroupsとして受け取るだけで、
// ここでは判定しない（唯一の分類ロジックはutils/dbCenterList.tsのgroupCenterItems）。

interface Props {
  groups: DbCenterGroup[];
  activeItemId?: string;
}

const { groups, activeItemId } = Astro.props;
---

<div class="db-problem-groups">
  {groups.map((group) => {
    const isActiveGroup = group.items.some((item) => item.id === activeItemId);
    return (
      <details class="db-problem-group" open={isActiveGroup}>
        <summary class="db-problem-group-toggle">
          <span class="db-problem-group-toggle-main">
            <span class="db-problem-group-caret" aria-hidden="true" />
            <span class="db-problem-group-label">{group.groupLabel}</span>
          </span>
          <span class="db-problem-group-count">{group.items.length}問</span>
        </summary>
        <ul class="db-problem-list">
          {group.items.map((item) => {
            const isSelected = item.id === activeItemId;
            // 表示用の3桁番号は既存ID（例: M1-QF-028）の末尾数字から取り出すだけで、
            // 問題データ自体は変更しない。問題詳細タイトル側（Quadratic27Detail.astro）
            // と同じdisplayProblemNumberを使い、表示番号の情報源を一本化する。
            const number = displayProblemNumber(item.id);
            return (
              <li class="db-problem-row">
                <a
                  class:list={['db-problem-link', isSelected && 'is-selected']}
                  href={item.href}
                  aria-current={isSelected ? 'page' : undefined}
                >
                  <span class="db-problem-number">{number}</span>
                  <span class="db-problem-title">{item.title}</span>
                  <span class="db-problem-chips">
                    {item.chips.map((chip, chipIndex) => (
                      // chips[0]は常にimportance_label（重要度）、chips[1]はdifficulty
                      // （難易度、数字文字列）という呼び出し側の組み立て順（*DbItems.ts）に
                      // 依存する。重要度チップだけにdata-importanceを付け、個別問題ページ・
                      // TOPページのCONCEPT説明と同じ色ルール（global.cssの[data-importance]）
                      // に乗せる。難易度チップは付けず、既存の控えめな見た目のまま。
                      <span class="db-problem-chip" data-importance={chipIndex === 0 ? chip : undefined}>
                        {chip}
                      </span>
                    ))}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    );
  })}
</div>

<style>
  .db-problem-groups {
    margin: 0 0 0.75rem;
  }
  .db-problem-group {
    margin-bottom: 0.5rem;
  }
  .db-problem-group:last-child {
    margin-bottom: 0;
  }
  /* 区分見出しは「開く/閉じるボタン」ではなく、ライブラリのセクションヘッダーとして
     問題行より明確に強く見せる（C案のような濃い操作パネルにはしない）。
     --color-accent-bgそのものだと通常行との差が弱く見えたため、同じ青灰系トーンを
     保ったまま--color-primaryをやや濃いめの割合で重ねた背景に強める。 */
  .db-problem-group-toggle {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius) var(--radius) 0 0;
    background: rgba(47, 95, 122, 0.14);
    font-weight: 700;
    font-size: 0.87rem;
    letter-spacing: 0.01em;
    color: var(--color-primary-dark);
  }
  .db-problem-group-toggle::-webkit-details-marker {
    display: none;
  }
  .db-problem-group-toggle:hover {
    background: rgba(47, 95, 122, 0.22);
  }
  .db-problem-group-toggle-main {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }
  /* 既存のthinking-step-caret（global.css）と同じ回転キャレットの考え方を、
     JS無しで<details>の[open]属性だけに連動させる。 */
  .db-problem-group-caret {
    flex-shrink: 0;
    width: 0.5em;
    height: 0.5em;
    border-right: 2px solid var(--color-primary-dark);
    border-bottom: 2px solid var(--color-primary-dark);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }
  .db-problem-group[open] > .db-problem-group-toggle .db-problem-group-caret {
    transform: rotate(45deg);
  }
  .db-problem-group-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .db-problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 問題行：カードではなく行リスト。強い枠・影・大きな角丸は付けず、
     細いborder-bottomだけで区切る。 */
  .db-problem-row {
    border-bottom: 1px solid var(--color-border);
  }
  .db-problem-row:last-child {
    border-bottom: none;
  }
  /* 番号・タイトル・チップの横位置は元々flex-grow（.db-problem-title）で
     行ごとに揃っていたが、align-items:centerだとタイトルの折り返し行数
     （1〜3行）ごとに縦位置が変わり、番号・チップが行によってバラついて見えていた。
     flex-startにして「1行目の高さ」に全項目を揃え、表としての安定感を出す。 */
  .db-problem-link {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-left: 4px solid transparent;
    color: var(--color-text);
    text-decoration: none;
  }
  .db-problem-link:hover {
    background: rgba(47, 95, 122, 0.045);
    text-decoration: none;
  }
  /* 選択中行：通常行との差を「区分見出し以上」に明確にするため、背景をアクセント
     濃度で直接指定し（--color-accent-bgより一段強い）、左アクセントも太く濃くする。 */
  .db-problem-link.is-selected {
    background: rgba(47, 95, 122, 0.16);
    border-left-color: var(--color-primary-dark);
  }
  .db-problem-number {
    flex-shrink: 0;
    width: 1.9rem;
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .db-problem-link.is-selected .db-problem-number {
    color: var(--color-primary-dark);
    font-weight: 700;
  }
  .db-problem-title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
  }
  .db-problem-link.is-selected .db-problem-title {
    font-weight: 700;
    color: var(--color-primary-dark);
  }
  /* 難易度チップ（data-importanceなし）はタイトルより目立たせない、中立トーンの
     弱い背景のままにしつつ、数字が薄く見えすぎないよう文字色だけ濃くする。
     重要度チップ（data-importanceあり）はglobal.cssの[data-importance]共通
     ルールに配色を任せるため、ここでは背景・文字色を指定しない
     （:not([data-importance])で明示的に除外する）。 */
  .db-problem-chips {
    flex-shrink: 0;
    display: flex;
    gap: 0.3rem;
  }
  .db-problem-chip {
    font-size: 0.68rem;
    border-radius: var(--radius);
    padding: 0.05rem 0.4rem;
    white-space: nowrap;
  }
  .db-problem-chip:not([data-importance]) {
    color: var(--color-text);
    background: rgba(28, 34, 41, 0.045);
  }
  .db-problem-link.is-selected .db-problem-chip:not([data-importance]) {
    background: rgba(255, 255, 255, 0.55);
    color: var(--color-text);
  }
</style>
