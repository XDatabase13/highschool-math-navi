---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="高校数学ナビ｜「何を解くか」で迷わないための高校数学ナビ"
  description="教科書の代表的な問題から定期試験の＋αまでを整理し、「まず何をやるか」「どこまでやるか」を考えるための目安を示す高校数学ナビ（試作公開中）。"
  showNav={false}
  largeBrand
  wideLayout
  topTheme
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@600&family=M+PLUS+2:wght@400;600&family=Noto+Sans+JP:wght@400&family=Zen+Maru+Gothic:wght@700&display=swap"
    />
  </Fragment>

  <section class="hero">
    <h1 class="hero-title hero-title--home">重要度と難易度で選べる<br />高校数学の問題データベース</h1>
    <p class="hero-tagline">重要度 × 難易度 × 定期試験 × ThinkingFlow</p>
    <div class="hero-badges">
      <span class="badge badge-status">試作公開中</span>
    </div>

    <div class="hero-actions">
      <a class="hero-cta-link" href="/app/">
        <span class="hero-cta-text">問題データベースを見る</span>
        <svg class="hero-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M4 12h15" />
          <path d="M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </section>

  <section class="hero-preview" aria-label="高校数学ナビの実際の画面">
    <button type="button" class="preview-trigger" data-lightbox-trigger aria-haspopup="dialog">
      <img
        class="preview-image"
        src="/images/top-db-preview.png"
        width="2556"
        height="1181"
        alt="高校数学ナビの問題データベース画面。左に科目・単元、中央に問題一覧、右に選択中の問題の詳細（問題文・問題メタ・解法メタ・ThinkingFlow・最終解答）が並ぶ3カラム構成。"
        loading="eager"
      />
    </button>
  </section>

  <section id="importance-difficulty" class="features-section" aria-labelledby="features-heading">
    <div class="features-intro">
      <p class="features-eyebrow">CONCEPT</p>
      <h2 id="features-heading" class="features-heading">高校数学ナビの4つの特徴</h2>
    </div>

    <div class="concept-grid" aria-label="サイトの4つの特徴">
      <div class="concept-col">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M24 8 L42 40 L6 40 Z" />
            <path d="M19.5 16 L28.5 16" />
            <path d="M15 24 L33 24" />
            <path d="M10.5 32 L37.5 32" />
          </svg>
        </div>
        <h3 class="concept-col-title">重要度</h3>
        <ul class="concept-items">
          <li class="concept-item">
            <span class="concept-item-label">土台</span>
            <span class="concept-item-desc">高校数学の土台</span>
          </li>
          <li class="concept-item">
            <span class="concept-item-label">本命</span>
            <span class="concept-item-desc">定期試験で優先</span>
          </li>
          <li class="concept-item">
            <span class="concept-item-label">次点</span>
            <span class="concept-item-desc">本命の次</span>
          </li>
          <li class="concept-item">
            <span class="concept-item-label">余力</span>
            <span class="concept-item-desc">余裕があれば</span>
          </li>
        </ul>
      </div>

      <div class="concept-col">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 41 H14 V34 H23 V27 H32 V20 H41 V13" />
          </svg>
        </div>
        <h3 class="concept-col-title">難易度</h3>
        <ol class="concept-items">
          <li class="concept-item concept-item--numbered">
            <span class="concept-item-num">1</span>
            <span class="concept-item-label">基本</span>
            <span class="concept-item-desc">教科書の基本</span>
          </li>
          <li class="concept-item concept-item--numbered">
            <span class="concept-item-num">2</span>
            <span class="concept-item-label">標準</span>
            <span class="concept-item-desc">教科書の標準</span>
          </li>
          <li class="concept-item concept-item--numbered">
            <span class="concept-item-num">3</span>
            <span class="concept-item-label">応用</span>
            <span class="concept-item-desc">教科書で難しい側</span>
          </li>
          <li class="concept-item concept-item--numbered">
            <span class="concept-item-num">4</span>
            <span class="concept-item-label">発展</span>
            <span class="concept-item-desc">応用より一段難しい</span>
          </li>
        </ol>
      </div>

      <div class="concept-col">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 20 L24 8 L40 20" />
            <path d="M10 20 V36 H30 V20" />
            <path d="M18 36 V28 H22 V36" />
            <rect x="27" y="25" width="14" height="18" rx="1.5" />
            <path d="M30.5 31 H37.5" />
            <path d="M30.5 35 H37.5" />
            <path d="M30.5 39 H35" />
          </svg>
        </div>
        <h3 class="concept-col-title">定期試験</h3>
        <div class="convergence-diagram">
          <div class="convergence-sources">
            <div class="convergence-source">
              <div class="convergence-icon" aria-hidden="true">
                <svg viewBox="0 0 64 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="58" height="36" rx="3" />
                  <path d="M21 4 V40" />
                  <path d="M8 12 H16" />
                  <path d="M8 20 H16" />
                  <path d="M8 28 H16" />
                  <path d="M27 12 H52" />
                  <path d="M27 20 H46" />
                  <rect x="27" y="27" width="16" height="7" rx="2" />
                </svg>
              </div>
              <p class="convergence-source-title">高校数学ナビ</p>
              <p class="convergence-source-sub">重要度・難易度</p>
            </div>
            <div class="convergence-source">
              <p class="convergence-source-title">学校の情報</p>
              <div class="convergence-subgroup">
                <div class="convergence-subitem">
                  <div class="convergence-icon convergence-icon--sub" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="20" height="14" rx="1.5" />
                      <path d="M8 10 H18" />
                      <path d="M8 14 H14" />
                      <path d="M7 18 L4 26" />
                      <path d="M19 18 L22 26" />
                    </svg>
                  </div>
                  <p class="convergence-subitem-label">授業</p>
                </div>
                <div class="convergence-subitem">
                  <div class="convergence-icon convergence-icon--sub" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 8 C4 8 10 6 16 9 C22 6 28 8 28 8 V24 C28 24 22 22 16 25 C10 22 4 24 4 24 Z" />
                      <path d="M16 9 V25" />
                    </svg>
                  </div>
                  <p class="convergence-subitem-label">教材</p>
                </div>
                <div class="convergence-subitem">
                  <div class="convergence-icon convergence-icon--sub" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="7" y="4" width="18" height="24" rx="1.5" />
                      <path d="M11 10 H21" />
                      <path d="M11 15 H21" />
                      <path d="M11 20 L14 23 L21 15" />
                    </svg>
                  </div>
                  <p class="convergence-subitem-label">傾向</p>
                </div>
              </div>
            </div>
          </div>
          <svg class="convergence-merge" viewBox="0 0 120 46" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2 L58 24" />
            <path d="M106 2 L62 24" />
            <circle cx="60" cy="26" r="3" />
            <path d="M60 30 V38" />
            <path d="M54 33 L60 40 L66 33" />
          </svg>
          <div class="convergence-target">
            <div class="convergence-icon convergence-icon--target" aria-hidden="true">
              <svg viewBox="0 0 32 44" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="10" r="7" />
                <path d="M4 40 C4 26 9 21 16 21 C23 21 28 26 28 40" />
              </svg>
            </div>
            <p class="convergence-target-label">あなたの優先順位</p>
          </div>
        </div>
      </div>

      <div class="concept-col">
        <div class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
            <rect x="15" y="5" width="18" height="9" rx="2" />
            <path d="M24 14 V19" />
            <path d="M24 19 L20.5 23 L24 27 L27.5 23 Z" />
            <path d="M24 27 V32" />
            <rect x="15" y="32" width="18" height="9" rx="2" />
          </svg>
        </div>
        <h3 class="concept-col-title">ThinkingFlow</h3>
        <div class="mini-flow" data-mini-flow>
          <ol class="mini-flow-steps">
            <li class="mini-flow-step">
              <button type="button" class="mini-flow-toggle" aria-expanded="false">
                <span class="mini-flow-step-num">STEP 1</span>
                <span class="mini-flow-step-title">式を整理する</span>
              </button>
              <div class="mini-flow-content">
                <div class="mini-flow-content-inner">
                  <p class="mini-flow-note">ax² + bx + c = 0 の形にする</p>
                </div>
              </div>
            </li>
            <li class="mini-flow-step">
              <button type="button" class="mini-flow-toggle" aria-expanded="false">
                <span class="mini-flow-step-num">STEP 2</span>
                <span class="mini-flow-step-title">判別式を見る</span>
              </button>
              <div class="mini-flow-content">
                <div class="mini-flow-content-inner">
                  <p class="mini-flow-formula">D = b² − 4ac</p>
                  <p class="mini-flow-note">D &gt; 0 を確認</p>
                </div>
              </div>
            </li>
            <li class="mini-flow-step">
              <button type="button" class="mini-flow-toggle" aria-expanded="false">
                <span class="mini-flow-step-num">STEP 3</span>
                <span class="mini-flow-step-title">条件を整理する</span>
              </button>
              <div class="mini-flow-content">
                <div class="mini-flow-content-inner">
                  <p class="mini-flow-note">Dの符号で実数解の個数を判断</p>
                </div>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <div class="dashboard">
    <section class="dash-section" aria-labelledby="about-heading">
      <h2 id="about-heading" class="dash-section-title">このサイトについて</h2>
      <div class="dash-card">
        <p>
          高校数学ナビは、定期試験で何を優先して解くかを考えるための高校数学データベースです。
        </p>
        <p>
          問題ごとに重要度・難易度を設定し、問題の見方や解き方、ThinkingFlowをまとめています。
          問題選定や重要度は、約20年の高校数学指導経験をもとに判断しています。
        </p>
        <p>
          現在は数学I「二次関数」54問を試作公開中です。今後、他の単元も順次追加していきます。
        </p>
      </div>
    </section>
  </div>

  <div class="lightbox-overlay" id="db-preview-lightbox" role="dialog" aria-modal="true" aria-label="問題データベース画面の拡大表示" hidden>
    <div class="lightbox-content">
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="閉じる">×</button>
      <img
        class="lightbox-image"
        src="/images/top-db-preview.png"
        alt="高校数学ナビの問題データベース画面（拡大表示）。左に科目・単元、中央に問題一覧、右に選択中の問題の詳細が並ぶ3カラム構成。"
      />
    </div>
  </div>

  <script>
    const trigger = document.querySelector('[data-lightbox-trigger]');
    const overlay = document.getElementById('db-preview-lightbox');

    if (trigger && overlay) {
      const closeBtn = overlay.querySelector('[data-lightbox-close]');
      const lightboxImage = overlay.querySelector('.lightbox-image');
      let lastFocused: HTMLElement | null = null;

      const onKeydown = (event: KeyboardEvent) => {
        if (event.key === 'Escape') closeLightbox();
      };

      function openLightbox() {
        lastFocused = document.activeElement as HTMLElement | null;
        overlay!.hidden = false;
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
        document.addEventListener('keydown', onKeydown);
      }

      function closeLightbox() {
        overlay!.hidden = true;
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeydown);
        lastFocused?.focus();
      }

      trigger.addEventListener('click', openLightbox);
      closeBtn?.addEventListener('click', closeLightbox);
      lightboxImage?.addEventListener('click', closeLightbox);
      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) closeLightbox();
      });
    }
  </script>

  <script>
    const miniFlow = document.querySelector<HTMLElement>('[data-mini-flow]');

    if (miniFlow) {
      const steps = Array.from(miniFlow.querySelectorAll<HTMLLIElement>('.mini-flow-step'));

      function setStepOpen(step: HTMLLIElement, open: boolean) {
        const btn = step.querySelector('.mini-flow-toggle');
        const content = step.querySelector('.mini-flow-content');
        btn?.setAttribute('aria-expanded', String(open));
        content?.classList.toggle('is-open', open);
      }

      // 手動開閉はreduced motion設定に関わらず常に有効にする。
      steps.forEach((step) => {
        const btn = step.querySelector('.mini-flow-toggle');
        btn?.addEventListener('click', () => {
          const isOpen = btn.getAttribute('aria-expanded') === 'true';
          setStepOpen(step, !isOpen);
        });
      });

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && steps.length >= 2) {
        let hasPlayed = false;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && !hasPlayed) {
                hasPlayed = true;
                observer.unobserve(miniFlow);
                playAutoDemo();
              }
            }
          },
          { threshold: 0.4 },
        );
        observer.observe(miniFlow);

        function playAutoDemo() {
          // STEP1を開く→少し見せてから閉じてSTEP2を開く→STEP2を開いたまま停止する
          // （STEP3は自動では開かない）。最終状態から先はすべて手動開閉に委ねる。
          const [step1, step2] = steps;
          setStepOpen(step1, true);
          setTimeout(() => {
            setStepOpen(step1, false);
            setStepOpen(step2, true);
          }, 1600);
        }
      }
    }
  </script>
</BaseLayout>
