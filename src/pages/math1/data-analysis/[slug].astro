---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareDataAnalysisEntry } from '../../../utils/prepareDataAnalysisEntry';
import { buildDataAnalysisCenterItems } from '../../../utils/dataAnalysisDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';

// データの分析の個別問題ページ。/math1/trig/[slug].astroと同じ構成
// （静的生成・共通DBシェル再利用）をdataAnalysisコレクションに対しても使う。
// 本番のURL契約（sitemap掲載・index対象化）を適用済み（QF/TRと同様、noindexは外す。
// AGENTS.md「データの分析の現在地」参照）。
export async function getStaticPaths() {
  const problems = await getVerifiedCollection('dataAnalysis');
  return problems.map((problem) => ({
    params: { slug: problem.id },
    props: { problem },
  }));
}

const { problem } = Astro.props;
const prepared = await prepareDataAnalysisEntry(problem);

const allProblems = (await getVerifiedCollection('dataAnalysis')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildDataAnalysisCenterItems(allProblems);
---

<ProblemDbShell
  title={`${problem.data.title} | 数学I データの分析 | 高校数学ナビ`}
  description={`${problem.data.title}（重要度：${problem.data.importance_label}／難易度：${problem.data.difficulty}）。数学I「データの分析」の問題データベースより、問題文・ThinkingFlow・最終解答を確認できます。`}
  canonicalPath={`/math1/data-analysis/${problem.id}/`}
  breadcrumb={`数学I ＞ データの分析 ＞ ${problem.data.title}`}
  activeUnitId="data-analysis"
  activeItemId={problem.id}
  centerItems={centerItems}
>
  <Quadratic27Detail prepared={prepared} />
</ProblemDbShell>
