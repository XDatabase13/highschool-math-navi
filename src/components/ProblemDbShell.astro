---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { publicSubjectNav } from '../data/subjects';
import Analytics from './Analytics.astro';

// 問題データベース用の共通3ペインUI。
// /app/・/math1/quadratic/・/math1/quadratic/[slug]/ など、
// 「1問題=1固有URL」を維持しつつ同じ表示基盤を使いたいページから利用する。
//
// 旧app/index.astroはJavaScriptで単元・問題を切り替えるSPA的な作りだったが、
// 検索エンジンが個別問題URLを独立ページとして辿れるようにするため、
// 単元・問題の切り替えは通常の<a href>によるページ遷移に統一した
// （中央ペイン・左ペインとも、選択状態は各ページの静的生成時に決める）。
//
// 中央ペインに表示する問題一覧（centerItems）は、呼び出し側が
// 単元ごとのデータソースから組み立てて渡す。このコンポーネント自体は
// 「id / href / title / chips」という共通の形しか知らないため、
// 今後の他単元追加時もこのコンポーネントを変更せずに再利用できる。

export interface DbCenterItem {
  id: string;
  href: string;
  title: string;
  chips: string[];
  // 中央ペインで「所属範囲」ごとにアコーディオン表示するためのグループ情報。
  // どの区分に属するかは呼び出し側（各問題データ）が正本として持ち、
  // このコンポーネント自身は問題IDやレンジで区分を判定しない。
  groupId: string;
  groupLabel: string;
}

interface DbCenterGroup {
  groupId: string;
  groupLabel: string;
  items: DbCenterItem[];
}

// centerItemsは呼び出し側で既に表示順（教科書ベースの順序）に並んでいる前提。
// 同じgroupIdが連続している区間をひとまとまりのグループとして扱うだけで、
// グループ名や境界をここでハードコードしない。
function groupCenterItems(items: DbCenterItem[]): DbCenterGroup[] {
  const groups: DbCenterGroup[] = [];
  for (const item of items) {
    const current = groups[groups.length - 1];
    if (current && current.groupId === item.groupId) {
      current.items.push(item);
    } else {
      groups.push({ groupId: item.groupId, groupLabel: item.groupLabel, items: [item] });
    }
  }
  return groups;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  breadcrumb: string;
  activeUnitId: string;
  activeItemId?: string;
  centerItems: DbCenterItem[];
  centerNote?: string;
  // /app/ は学習DBの入口として維持するが、検索対象からは外す
  // （個別問題ページと内容が重複するため）。canonicalは自身のまま、
  // クロール自体は妨げないよう noindex,follow を使う。
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  breadcrumb,
  activeUnitId,
  activeItemId,
  centerItems,
  centerNote,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const centerGroups = groupCenterItems(centerItems);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <div class="db-shell">
      <header class="db-header">
        <a class="db-header-title" href="/">高校数学ナビ</a>
        <span class="db-current-path">{breadcrumb}</span>
        <a class="db-header-back" href="/">← トップへ戻る</a>
        <nav class="db-header-info" aria-label="サイト情報">
          <a href="/privacy/">プライバシー</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/contact/">お問い合わせ</a>
        </nav>
      </header>

      <div class="db-body">
        <nav class="db-pane db-pane-subjects" aria-label="科目・単元">
          <ul class="db-subject-list">
            {publicSubjectNav
              .filter((subject) => subject.units.length > 0)
              .map((subject) => (
                <li class="db-subject">
                  <span class="db-subject-name">{subject.name}</span>
                  <ul class="db-unit-list">
                    {subject.units.map((unit) => (
                      <li>
                        <a
                          class:list={['db-unit-btn', unit.id === activeUnitId && 'is-selected']}
                          href={unit.href}
                          aria-current={unit.id === activeUnitId ? 'page' : undefined}
                        >
                          {unit.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
          </ul>
          <p class="db-subject-note">他の単元は順次追加予定</p>
        </nav>

        <details class="db-pane db-pane-list" aria-label="問題一覧">
          <summary class="db-list-toggle">問題一覧を開く（全{centerItems.length}問）</summary>
          <div class="db-problem-groups">
            {centerGroups.map((group) => {
              const isActiveGroup = group.items.some((item) => item.id === activeItemId);
              return (
                <details class="db-problem-group" open={isActiveGroup}>
                  <summary class="db-problem-group-toggle">
                    <span class="db-problem-group-toggle-main">
                      <span class="db-problem-group-caret" aria-hidden="true" />
                      <span class="db-problem-group-label">{group.groupLabel}</span>
                    </span>
                    <span class="db-problem-group-count">{group.items.length}問</span>
                  </summary>
                  <ul class="db-problem-list">
                    {group.items.map((item) => {
                      const isSelected = item.id === activeItemId;
                      // 表示用の3桁番号は既存ID（例: M1-QF-028）の末尾数字から取り出すだけで、
                      // 問題データ自体は変更しない。末尾に数字が無いIDでは空文字にフォールバックする。
                      const number = item.id.match(/(\d+)$/)?.[0] ?? '';
                      return (
                        <li class="db-problem-row">
                          <a
                            class:list={['db-problem-link', isSelected && 'is-selected']}
                            href={item.href}
                            aria-current={isSelected ? 'page' : undefined}
                          >
                            <span class="db-problem-number">{number}</span>
                            <span class="db-problem-title">{item.title}</span>
                            <span class="db-problem-chips">
                              {item.chips.map((chip) => (
                                <span class="db-problem-chip">{chip}</span>
                              ))}
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </details>
              );
            })}
          </div>
          {centerNote && <p class="db-list-note">{centerNote}</p>}
        </details>

        <section class="db-pane db-pane-detail" aria-label="選択中の問題の詳細">
          <slot />
        </section>
      </div>
    </div>

    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }

      .db-shell {
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--color-bg);
      }

      .db-header {
        flex-shrink: 0;
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        padding: 0.55rem 1rem;
        background: var(--color-primary-dark);
        color: #fff;
      }
      .db-header-title {
        font-weight: 700;
        font-size: 1.05rem;
        color: #fff;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .db-header-title:hover {
        text-decoration: none;
        opacity: 0.9;
      }
      .db-current-path {
        margin-left: auto;
        font-size: 0.8rem;
        color: #d6e3ea;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .db-header-back {
        font-size: 0.8rem;
        color: #bcdff0;
        flex-shrink: 0;
        padding: 0.3rem 0.6rem;
        margin: -0.3rem -0.6rem -0.3rem 0;
        border-radius: var(--radius);
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .db-header-back:hover {
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        text-decoration: none;
      }
      .db-header-info {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-shrink: 0;
        padding-left: 0.8rem;
        border-left: 1px solid rgba(255, 255, 255, 0.25);
      }
      .db-header-info a {
        font-size: 0.75rem;
        color: #bcdff0;
      }
      .db-header-info a:hover {
        color: #fff;
        text-decoration: none;
      }

      .db-body {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 200px 300px 1fr;
      }

      .db-pane {
        min-height: 0;
        overflow-y: auto;
      }

      .db-pane-subjects {
        border-right: 1px solid var(--color-border);
        background: var(--color-surface);
        padding: 1rem 0.75rem;
      }
      .db-subject-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .db-subject {
        margin-bottom: 1rem;
      }
      .db-subject-name {
        display: block;
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-bottom: 0.35rem;
      }
      .db-unit-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .db-unit-btn {
        display: block;
        width: 100%;
        text-align: left;
        border: none;
        background: transparent;
        border-radius: var(--radius);
        padding: 0.4rem 0.6rem;
        margin-bottom: 0.15rem;
        font-size: 0.9rem;
        color: var(--color-text);
        text-decoration: none;
      }
      .db-unit-btn:hover {
        background: var(--color-accent-bg);
        text-decoration: none;
      }
      .db-unit-btn.is-selected {
        background: var(--color-primary);
        color: #fff;
        font-weight: 700;
      }
      .db-subject-note {
        margin: 1rem 0 0;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .db-pane-list {
        border-right: 1px solid var(--color-border);
        background: var(--color-bg);
        padding: 0.9rem;
      }
      .db-list-toggle {
        cursor: pointer;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--color-primary-dark);
        padding: 0.3rem 0.1rem;
      }
      .db-problem-groups {
        margin: 0 0 0.75rem;
      }
      .db-problem-group {
        margin-bottom: 0.5rem;
      }
      .db-problem-group:last-child {
        margin-bottom: 0;
      }
      /* 区分見出しは「開く/閉じるボタン」ではなく、ライブラリのセクションヘッダーとして
         問題行より明確に強く見せる（C案のような濃い操作パネルにはしない）。
         --color-accent-bgそのものだと通常行との差が弱く見えたため、同じ青灰系トーンを
         保ったまま--color-primaryをやや濃いめの割合で重ねた背景に強める。 */
      .db-problem-group-toggle {
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.5rem 0.6rem;
        border-radius: var(--radius) var(--radius) 0 0;
        background: rgba(47, 95, 122, 0.14);
        font-weight: 700;
        font-size: 0.87rem;
        letter-spacing: 0.01em;
        color: var(--color-primary-dark);
      }
      .db-problem-group-toggle::-webkit-details-marker {
        display: none;
      }
      .db-problem-group-toggle:hover {
        background: rgba(47, 95, 122, 0.22);
      }
      .db-problem-group-toggle-main {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        min-width: 0;
      }
      /* 既存のthinking-step-caret（global.css）と同じ回転キャレットの考え方を、
         JS無しで<details>の[open]属性だけに連動させる。 */
      .db-problem-group-caret {
        flex-shrink: 0;
        width: 0.5em;
        height: 0.5em;
        border-right: 2px solid var(--color-primary-dark);
        border-bottom: 2px solid var(--color-primary-dark);
        transform: rotate(-45deg);
        transition: transform 0.15s ease;
      }
      .db-problem-group[open] > .db-problem-group-toggle .db-problem-group-caret {
        transform: rotate(45deg);
      }
      .db-problem-group-count {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-text-muted);
        flex-shrink: 0;
      }
      .db-problem-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      /* 問題行：カードではなく行リスト。強い枠・影・大きな角丸は付けず、
         細いborder-bottomだけで区切る。 */
      .db-problem-row {
        border-bottom: 1px solid var(--color-border);
      }
      .db-problem-row:last-child {
        border-bottom: none;
      }
      .db-problem-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.6rem;
        border-left: 4px solid transparent;
        color: var(--color-text);
        text-decoration: none;
      }
      .db-problem-link:hover {
        background: rgba(47, 95, 122, 0.045);
        text-decoration: none;
      }
      /* 選択中行：通常行との差を「区分見出し以上」に明確にするため、背景をアクセント
         濃度で直接指定し（--color-accent-bgより一段強い）、左アクセントも太く濃くする。 */
      .db-problem-link.is-selected {
        background: rgba(47, 95, 122, 0.16);
        border-left-color: var(--color-primary-dark);
      }
      .db-problem-number {
        flex-shrink: 0;
        width: 1.9rem;
        font-variant-numeric: tabular-nums;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }
      .db-problem-link.is-selected .db-problem-number {
        color: var(--color-primary-dark);
        font-weight: 700;
      }
      .db-problem-title {
        flex: 1 1 auto;
        min-width: 0;
        font-size: 0.85rem;
        font-weight: 500;
        line-height: 1.35;
        color: var(--color-text);
      }
      .db-problem-link.is-selected .db-problem-title {
        font-weight: 700;
        color: var(--color-primary-dark);
      }
      /* チップはタイトルより目立たせない。彩度のある青系ではなく、
         中立トーンの弱い背景＋muted文字色にとどめる。 */
      .db-problem-chips {
        flex-shrink: 0;
        display: flex;
        gap: 0.3rem;
      }
      .db-problem-chip {
        font-size: 0.68rem;
        color: var(--color-text-muted);
        background: rgba(35, 35, 35, 0.045);
        border-radius: 4px;
        padding: 0.05rem 0.4rem;
        white-space: nowrap;
      }
      .db-problem-link.is-selected .db-problem-chip {
        background: rgba(255, 255, 255, 0.55);
        color: var(--color-text-muted);
      }
      .db-list-note {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin: 0.5rem 0 0;
      }

      .db-pane-detail {
        background: var(--color-surface);
        padding: 1.5rem 1.75rem 3rem;
      }
      .db-pane-detail :global(h1) {
        margin-top: 0;
      }

      /* PCでは<details>の開閉状態に関わらず問題一覧を常に展開表示し、
         スマホ専用の開閉導線（summary）は隠す。3ペインの見た目・操作感は維持する。 */
      @media (min-width: 901px) {
        .db-pane-list > summary {
          display: none;
        }
        .db-pane-list > *:not(summary) {
          display: block;
        }
        /* Chromeの新しい<details>実装は、閉じた状態の中身を
           ::details-content という擬似要素でcontent-visibility: hiddenかつ
           高さ0にラップする。上のdisplay上書きだけでは子要素自体の
           displayしか変えられずこの擬似要素までは効かないため、
           PC幅ではこちらも明示的に開いた状態相当へ上書きする。 */
        .db-pane-list::details-content {
          content-visibility: visible;
          block-size: auto;
          height: auto;
          overflow: visible;
        }
      }

      /* PCの3ペインをスマホへ無理に縮小しない。狭幅では表示優先順位を
         「ヘッダー→選択中の問題詳細→問題一覧を開く導線→問題一覧→科目・単元ナビ」
         に組み替え、問題一覧は<details>で折りたたむ。 */
      @media (max-width: 900px) {
        .db-shell {
          height: auto;
          min-height: 100vh;
        }
        .db-body {
          display: flex;
          flex-direction: column;
        }
        .db-pane {
          overflow-y: visible;
        }
        .db-pane-detail {
          order: 1;
        }
        .db-pane-list {
          order: 2;
        }
        .db-pane-subjects {
          order: 3;
        }
        .db-pane-subjects,
        .db-pane-list {
          border-right: none;
          border-bottom: none;
          border-top: 1px solid var(--color-border);
        }
        .db-current-path {
          display: none;
        }

        .db-header {
          flex-wrap: wrap;
          row-gap: 0.35rem;
        }
        .db-header-back {
          display: none;
        }
        .db-header-info {
          flex: 1 1 100%;
          margin-left: 0;
          padding-left: 0;
          border-left: none;
          flex-wrap: wrap;
        }
      }
    </style>
  </body>
</html>
