---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareSetLogicEntry } from '../../../utils/prepareSetLogicEntry';
import { buildSetLogicCenterItems } from '../../../utils/setLogicDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';

// 集合と論証の個別問題ページ。/math1/suto-shiki/[slug].astroと同じ構成
// （静的生成・共通DBシェル再利用）をsetLogicコレクションに対しても使う。
// 他単元と同格の公開contract（index対象・sitemap掲載・canonicalは自身のURL）とする。
export async function getStaticPaths() {
  const problems = await getVerifiedCollection('setLogic');
  return problems.map((problem) => ({
    params: { slug: problem.id },
    props: { problem },
  }));
}

const { problem } = Astro.props;
const prepared = await prepareSetLogicEntry(problem);

const allProblems = (await getVerifiedCollection('setLogic')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildSetLogicCenterItems(allProblems);
---

<ProblemDbShell
  title={`${problem.data.title} | 数学I 集合と論証 | 高校数学ナビ`}
  description={`${problem.data.title}（重要度：${problem.data.importance_label}／難易度：${problem.data.difficulty}）。数学I「集合と論証」の問題データベースより、問題文・ThinkingFlow・最終解答を確認できます。`}
  canonicalPath={`/math1/set-logic/${problem.id}/`}
  breadcrumbItems={[
    { label: '数学I' },
    { label: '集合と論証', href: '/math1/set-logic/' },
    { label: problem.data.title },
  ]}
  activeUnitId="set-logic"
  activeItemId={problem.id}
  centerItems={centerItems}
>
  <Quadratic27Detail prepared={prepared} />
</ProblemDbShell>
