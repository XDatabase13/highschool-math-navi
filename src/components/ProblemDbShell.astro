---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { publicSubjectNav } from '../data/subjects';
import Analytics from './Analytics.astro';
import ProblemGroupList from './ProblemGroupList.astro';
import { groupCenterItems, type DbCenterItem } from '../utils/dbCenterList';

// 問題データベース用の共通3ペインUI。
// /app/・/math1/quadratic/・/math1/quadratic/[slug]/ など、
// 「1問題=1固有URL」を維持しつつ同じ表示基盤を使いたいページから利用する。
//
// 旧app/index.astroはJavaScriptで単元・問題を切り替えるSPA的な作りだったが、
// 検索エンジンが個別問題URLを独立ページとして辿れるようにするため、
// 単元・問題の切り替えは通常の<a href>によるページ遷移に統一した
// （中央ペイン・左ペインとも、選択状態は各ページの静的生成時に決める）。
//
// 中央ペインに表示する問題一覧（centerItems）は、呼び出し側が
// 単元ごとのデータソースから組み立てて渡す。このコンポーネント自体は
// 「id / href / title / chips」という共通の形しか知らないため、
// 今後の他単元追加時もこのコンポーネントを変更せずに再利用できる。
//
// 分類（groupCenterItems）とその表示（ProblemGroupList）はPC中央列・
// スマホ用問題一覧ダイアログの両方で共有する唯一の実装で、ここでは
// 別の分類ロジックを作らない。

export type { DbCenterItem };

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  breadcrumb: string;
  activeUnitId: string;
  activeItemId?: string;
  centerItems: DbCenterItem[];
  centerNote?: string;
  // /app/ は学習DBの入口として維持するが、検索対象からは外す
  // （個別問題ページと内容が重複するため）。canonicalは自身のまま、
  // クロール自体は妨げないよう noindex,follow を使う。
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  breadcrumb,
  activeUnitId,
  activeItemId,
  centerItems,
  centerNote,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const centerGroups = groupCenterItems(centerItems);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <div class="db-shell">
      <header class="db-header">
        <a class="db-header-title" href="/">高校数学ナビ</a>
        <span class="db-current-path">{breadcrumb}</span>
        <a class="db-header-back" href="/">← トップへ戻る</a>
        <nav class="db-header-info" aria-label="サイト情報">
          <a href="/privacy/">プライバシー</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/contact/">お問い合わせ</a>
        </nav>
      </header>

      <div class="db-body">
        <nav class="db-pane db-pane-subjects" aria-label="科目・単元">
          <ul class="db-subject-list">
            {publicSubjectNav
              .filter((subject) => subject.units.length > 0)
              .map((subject) => (
                <li class="db-subject">
                  <span class="db-subject-name">{subject.name}</span>
                  <ul class="db-unit-list">
                    {subject.units.map((unit) => (
                      <li>
                        <a
                          class:list={['db-unit-btn', unit.id === activeUnitId && 'is-selected']}
                          href={unit.href}
                          aria-current={unit.id === activeUnitId ? 'page' : undefined}
                        >
                          {unit.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
          </ul>
          <p class="db-subject-note">他の単元は順次追加予定</p>
        </nav>

        <details class="db-pane db-pane-list" aria-label="問題一覧">
          <summary class="db-list-toggle">問題一覧を開く（全{centerItems.length}問）</summary>
          <ProblemGroupList groups={centerGroups} activeItemId={activeItemId} />
          {centerNote && <p class="db-list-note">{centerNote}</p>}
        </details>

        <section class="db-pane db-pane-detail" aria-label="選択中の問題の詳細">
          <slot />
        </section>
      </div>

      <!-- スマホ幅専用：本文を読んでいる最中でも常に問題一覧へ移動できる導線。
           PC幅では非表示（CSSのみで切り替え、PC側のマークアップ・挙動は変えない）。
           一覧の中身はPC中央列と同じProblemGroupList（同じ分類・同じマークアップ）を
           そのまま再利用し、別の分類ロジックを作らない。 -->
      <button
        type="button"
        class="mobile-problem-trigger"
        data-mobile-problem-trigger
        aria-haspopup="dialog"
        aria-controls="mobile-problem-dialog"
      >
        <svg class="mobile-problem-trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        問題一覧
      </button>

      <dialog
        id="mobile-problem-dialog"
        class="mobile-problem-dialog"
        aria-labelledby="mobile-problem-dialog-title"
        data-mobile-problem-dialog
      >
        <div class="mobile-problem-dialog-header">
          <h2 id="mobile-problem-dialog-title" class="mobile-problem-dialog-title">問題一覧</h2>
          <button type="button" class="mobile-problem-dialog-close" data-mobile-problem-close aria-label="問題一覧を閉じる">
            ✕
          </button>
        </div>
        <div class="mobile-problem-dialog-body">
          <ProblemGroupList groups={centerGroups} activeItemId={activeItemId} />
        </div>
      </dialog>
    </div>

    <script>
      // スマホ用問題一覧ダイアログの開閉のみを担当する最小限のJS。
      // <dialog>のshowModal()に、背景の操作不可・フォーカストラップ・
      // Escで閉じる、をブラウザ標準機能として任せる（自前実装しない）。
      const trigger = document.querySelector<HTMLButtonElement>('[data-mobile-problem-trigger]');
      const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-problem-dialog]');

      if (trigger && dialog && typeof dialog.showModal === 'function') {
        trigger.addEventListener('click', () => {
          dialog.showModal();
        });

        dialog.querySelectorAll<HTMLButtonElement>('[data-mobile-problem-close]').forEach((closeBtn) => {
          closeBtn.addEventListener('click', () => dialog.close());
        });

        // backdrop（ダイアログ自身の余白部分）をクリックしたら閉じる。
        // 内部のリンク・ボタン等はイベントがそこで止まるため、targetが
        // dialog自身のときだけbackdropクリックとみなせる。
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) {
            dialog.close();
          }
        });

        // 問題を選択して遷移する場合はページ遷移そのものが閉じる役割を果たすため、
        // ここでは開閉状態の後始末は不要。
      }
    </script>

    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }

      .db-shell {
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--color-bg);
      }

      .db-header {
        flex-shrink: 0;
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        padding: 0.55rem 1rem;
        background: var(--color-primary-dark);
        color: #fff;
      }
      .db-header-title {
        font-weight: 700;
        font-size: 1.05rem;
        color: #fff;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .db-header-title:hover {
        text-decoration: none;
        opacity: 0.9;
      }
      .db-current-path {
        margin-left: auto;
        font-size: 0.8rem;
        color: #d6e3ea;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .db-header-back {
        font-size: 0.8rem;
        color: #bcdff0;
        flex-shrink: 0;
        padding: 0.3rem 0.6rem;
        margin: -0.3rem -0.6rem -0.3rem 0;
        border-radius: var(--radius);
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .db-header-back:hover {
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        text-decoration: none;
      }
      .db-header-info {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-shrink: 0;
        padding-left: 0.8rem;
        border-left: 1px solid rgba(255, 255, 255, 0.25);
      }
      .db-header-info a {
        font-size: 0.75rem;
        color: #bcdff0;
      }
      .db-header-info a:hover {
        color: #fff;
        text-decoration: none;
      }

      .db-body {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 200px 300px 1fr;
      }

      .db-pane {
        min-height: 0;
        overflow-y: auto;
      }

      .db-pane-subjects {
        border-right: 1px solid var(--color-border);
        background: var(--color-surface);
        padding: 1rem 0.75rem;
      }
      .db-subject-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .db-subject {
        margin-bottom: 1rem;
      }
      .db-subject-name {
        display: block;
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-bottom: 0.35rem;
      }
      .db-unit-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .db-unit-btn {
        display: block;
        width: 100%;
        text-align: left;
        border: none;
        background: transparent;
        border-radius: var(--radius);
        padding: 0.4rem 0.6rem;
        margin-bottom: 0.15rem;
        font-size: 0.9rem;
        color: var(--color-text);
        text-decoration: none;
      }
      .db-unit-btn:hover {
        background: var(--color-accent-bg);
        text-decoration: none;
      }
      .db-unit-btn.is-selected {
        background: var(--color-primary);
        color: #fff;
        font-weight: 700;
      }
      .db-subject-note {
        margin: 1rem 0 0;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .db-pane-list {
        border-right: 1px solid var(--color-border);
        background: var(--color-bg);
        padding: 0.9rem;
      }
      .db-list-toggle {
        cursor: pointer;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--color-primary-dark);
        padding: 0.3rem 0.1rem;
      }
      /* .db-problem-groups以下の一覧本体スタイルはProblemGroupList.astro側の
         スコープ済みCSSへ移動済み（PC中央列・スマホダイアログの両方から
         同じコンポーネント・同じCSSを再利用するため）。 */
      .db-list-note {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin: 0.5rem 0 0;
      }

      .db-pane-detail {
        background: var(--color-surface);
        padding: 1.5rem 1.75rem 3rem;
      }
      .db-pane-detail :global(h1) {
        margin-top: 0;
      }

      /* PCでは<details>の開閉状態に関わらず問題一覧を常に展開表示し、
         スマホ専用の開閉導線（summary）は隠す。3ペインの見た目・操作感は維持する。
         中身（ProblemGroupList）は別コンポーネントとしてスコープが異なるため、
         :global()でスコープ属性に依存しない形にしておく。 */
      @media (min-width: 901px) {
        .db-pane-list > summary {
          display: none;
        }
        :global(.db-pane-list > *:not(summary)) {
          display: block;
        }
        /* Chromeの新しい<details>実装は、閉じた状態の中身を
           ::details-content という擬似要素でcontent-visibility: hiddenかつ
           高さ0にラップする。上のdisplay上書きだけでは子要素自体の
           displayしか変えられずこの擬似要素までは効かないため、
           PC幅ではこちらも明示的に開いた状態相当へ上書きする。 */
        :global(.db-pane-list::details-content) {
          content-visibility: visible;
          block-size: auto;
          height: auto;
          overflow: visible;
        }
        /* スマホ専用の問題一覧導線・ダイアログはPCでは常に非表示。 */
        .mobile-problem-trigger,
        .mobile-problem-dialog {
          display: none !important;
        }
      }

      /* PCの3ペインをスマホへ無理に縮小しない。狭幅では表示優先順位を
         「ヘッダー→選択中の問題詳細→問題一覧を開く導線→問題一覧→科目・単元ナビ」
         に組み替え、問題一覧は<details>で折りたたむ。 */
      @media (max-width: 900px) {
        .db-shell {
          height: auto;
          min-height: 100vh;
        }
        .db-body {
          display: flex;
          flex-direction: column;
        }
        .db-pane {
          overflow-y: visible;
        }
        .db-pane-detail {
          order: 1;
        }
        .db-pane-list {
          order: 2;
        }
        .db-pane-subjects {
          order: 3;
        }
        .db-pane-subjects,
        .db-pane-list {
          border-right: none;
          border-bottom: none;
          border-top: 1px solid var(--color-border);
        }
        .db-current-path {
          display: none;
        }

        .db-header {
          flex-wrap: wrap;
          row-gap: 0.35rem;
        }
        .db-header-back {
          display: none;
        }
        .db-header-info {
          flex: 1 1 100%;
          margin-left: 0;
          padding-left: 0;
          border-left: none;
          flex-wrap: wrap;
        }

        /* スマホ専用：本文を読んでいる途中でも常に問題一覧へ移動できる、
           画面右上固定のピル型ボタン。強い影・派手なアニメーションは付けない。 */
        .mobile-problem-trigger {
          display: inline-flex;
          align-items: center;
          gap: 0.3rem;
          position: fixed;
          top: 0.6rem;
          right: 0.6rem;
          z-index: 20;
          min-height: 44px;
          padding: 0.5rem 0.85rem;
          border: 1px solid var(--color-border);
          border-radius: 999px;
          background: var(--color-surface);
          color: var(--color-primary-dark);
          font-size: 0.8rem;
          font-weight: 700;
          box-shadow: 0 2px 6px rgba(21, 40, 54, 0.16);
          cursor: pointer;
        }
        .mobile-problem-trigger-icon {
          width: 1.05em;
          height: 1.05em;
          flex-shrink: 0;
        }
        .mobile-problem-trigger:focus-visible,
        .mobile-problem-dialog-close:focus-visible {
          outline: 2px solid var(--color-accent);
          outline-offset: 2px;
        }

        /* 問題一覧ダイアログ：<dialog>のshowModal()に、背景操作の無効化・
           フォーカストラップ・Escでの close を任せる（自前実装しない）。
           右側からのドロワー的な配置のみCSSで調整する。 */
        .mobile-problem-dialog {
          position: fixed;
          inset: 0 0 0 auto;
          margin: 0;
          padding: 0;
          border: none;
          width: min(86vw, 380px);
          max-width: none;
          height: 100%;
          max-height: none;
          background: var(--color-bg);
          box-shadow: -6px 0 24px rgba(21, 40, 54, 0.18);
        }
        .mobile-problem-dialog::backdrop {
          background: rgba(21, 40, 54, 0.45);
        }
        .mobile-problem-dialog[open] {
          display: flex;
          flex-direction: column;
        }
        .mobile-problem-dialog-header {
          flex-shrink: 0;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 0.5rem;
          padding: 0.85rem 0.9rem;
          border-bottom: 1px solid var(--color-border);
          background: var(--color-primary-dark);
        }
        .mobile-problem-dialog-title {
          margin: 0;
          font-size: 1rem;
          font-weight: 700;
          color: #fff;
        }
        .mobile-problem-dialog-close {
          flex-shrink: 0;
          width: 44px;
          height: 44px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          border: none;
          border-radius: 999px;
          background: rgba(255, 255, 255, 0.14);
          color: #fff;
          font-size: 1.05rem;
          line-height: 1;
          cursor: pointer;
        }
        .mobile-problem-dialog-close:hover {
          background: rgba(255, 255, 255, 0.26);
        }
        .mobile-problem-dialog-body {
          flex: 1;
          min-height: 0;
          overflow-y: auto;
          padding: 0.75rem 0.9rem 1.25rem;
        }
      }
    </style>
  </body>
</html>
