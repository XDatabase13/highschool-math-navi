# .env としてコピーして使う（.envはGit管理外）。

# ThinkingFlow AI質問機能そのもののfeature flag。準備が整うまで本番では
# 必ずfalse（またはこの行自体を省略）にしておく。安全な初期値としてfalseを既定にする。
PUBLIC_AI_ENABLED=false

# ThinkingFlow AI質問機能（ローカルプロトタイプ）が通信するCloudflare WorkerのURL。
# ローカル：wrangler dev のデフォルトポート。本番切り替え時はここを変更するだけでよい。
PUBLIC_AI_WORKER_URL=http://127.0.0.1:8787

# 上記2つがどちらも揃って初めて実通信する：
#   PUBLIC_AI_ENABLED=true かつ PUBLIC_AI_WORKER_URL設定済み → 有効
#   PUBLIC_AI_ENABLED=false／未設定、またはPUBLIC_AI_WORKER_URL未設定 → 無効（安全側）
