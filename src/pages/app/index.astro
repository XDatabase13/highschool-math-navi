---
import '../../styles/global.css';
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import { prepareQuadratic27Entry } from '../../utils/prepareQuadratic27Entry';
import SutoShikiDetail from '../../components/SutoShikiDetail.astro';
import Quadratic27Detail from '../../components/Quadratic27Detail.astro';
import TrigProblemDetail from '../../components/TrigProblemDetail.astro';
import DataAnalysisDetail from '../../components/DataAnalysisDetail.astro';
import ProbabilityDetail from '../../components/ProbabilityDetail.astro';
import MenelausDetail from '../../components/MenelausDetail.astro';
import { subjectNav, publicSubjectNav } from '../../data/subjects';
import { sutoShikiProblems } from '../../data/math1/suto-shiki';
import { trigProblems } from '../../data/math1/trig';
import { dataAnalysisProblems } from '../../data/math1/data-analysis';
import { probabilityProblems } from '../../data/mathA/probability';
import { geometryProblems } from '../../data/mathA/geometry';

// 正式公開DB：Content Collections経由で正本Markdown（math_db_quadratic_working/problems/）を読み込む。
// TSへの手動転記はしない。
// 正本Markdownの分割・asset対応付けは utils/prepareQuadratic27Entry（[slug].astroと共通）で行う。
// 表示は Quadratic27Detail コンポーネント（同じく[slug].astroと共通）に委ねる。
const quadratic27Entries = (
  await Promise.all((await getCollection('quadratic27')).map((entry) => prepareQuadratic27Entry(entry)))
).sort((a, b) => a.entry.data.display_order - b.entry.data.display_order);

// このページでナビゲーション可能な単元は、実データを持つ6つ（数学I 4つ + 数学A 2つ）。
// href文字列から単元IDへの対応は、この6単元分のみ判定できればよい。
// 科目・単元ペイン自体は公開向けに publicSubjectNav（sampleOnly除外）で描画するが、
// パンくず用のunitMetaは6問検証サンプル分も含めて引けるよう subjectNav（全件）から作る。
function unitIdFromHref(href: string): string {
  if (href.includes('suto-shiki')) return 'suto-shiki';
  if (href.includes('quadratic')) return 'quadratic';
  if (href.includes('trig')) return 'trig';
  if (href.includes('data-analysis')) return 'data-analysis';
  if (href.includes('probability')) return 'probability';
  if (href.includes('geometry')) return 'geometry';
  return '';
}

// 単元IDから「科目名・単元名」を引けるようにする。
// 数学I決め打ちだったパンくず表示を、subjectNavから動的に求める形に直した
// （数学A追加にあたって最低限必要になった修正）。
const unitMeta: Record<string, { subject: string; unit: string }> = {};
for (const subject of subjectNav) {
  for (const unit of subject.units) {
    const unitId = unitIdFromHref(unit.href);
    if (unitId) {
      unitMeta[unitId] = { subject: subject.name, unit: unit.name };
    }
  }
}

// 正式公開DBの初期表示は数学I「二次関数」（M1-QF-001〜054）。
// 6問検証サンプルは publicSubjectNav側で科目・単元ペインから既に外れているため、
// 初期選択先として使わない。
const DEFAULT_UNIT = 'quadratic';
const DEFAULT_PROBLEM = `quadratic:${quadratic27Entries[0].entry.id}`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>問題データベース（試作） | 高校数学ナビ</title>
  </head>
  <body>
    <div class="db-shell">
      <header class="db-header">
        <span class="db-header-title">高校数学ナビ</span>
        <span class="db-current-path" id="db-current-path">
          数学I ＞ 二次関数 ＞ {quadratic27Entries[0].entry.data.title}
        </span>
        <a class="db-header-back" href="/">← トップへ戻る</a>
        <nav class="db-header-info" aria-label="サイト情報">
          <a href="/privacy/">プライバシー</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/contact/">お問い合わせ</a>
        </nav>
      </header>

      <div class="db-body">
        <nav class="db-pane db-pane-subjects" aria-label="科目・単元">
          <ul class="db-subject-list">
            {publicSubjectNav
              .filter((subject) => subject.units.length > 0)
              .map((subject) => (
                <li class="db-subject">
                  <span class="db-subject-name">{subject.name}</span>
                  <ul class="db-unit-list">
                    {subject.units.map((unit) => {
                      const unitId = unitIdFromHref(unit.href);
                      return (
                        <li>
                          <button
                            type="button"
                            class:list={['db-unit-btn', unitId === DEFAULT_UNIT && 'is-selected']}
                            data-unit-id={unitId}
                            aria-current={unitId === DEFAULT_UNIT ? 'true' : undefined}
                          >
                            {unit.name}
                          </button>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              ))}
          </ul>
          <p class="db-subject-note">他の単元は順次追加予定</p>
        </nav>

        <section class="db-pane db-pane-list" aria-label="問題一覧">
          <ul class="db-problem-list" data-unit-panel="suto-shiki" hidden>
            {sutoShikiProblems.map((problem) => (
              <li>
                <button
                  type="button"
                  class:list={[
                    'db-problem-item',
                    `suto-shiki:${problem.slug}` === DEFAULT_PROBLEM && 'is-selected',
                  ]}
                  data-problem-id={`suto-shiki:${problem.slug}`}
                >
                  <span class="db-problem-title">{problem.title}</span>
                  <span class="db-problem-meta">
                    {problem.labels.map((label) => (
                      <span class="db-problem-chip">{label.name}：{label.value}</span>
                    ))}
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <ul class="db-problem-list" data-unit-panel="quadratic">
            {quadratic27Entries.map(({ entry }) => (
              <li>
                <button
                  type="button"
                  class:list={[
                    'db-problem-item',
                    `quadratic:${entry.id}` === DEFAULT_PROBLEM && 'is-selected',
                  ]}
                  data-problem-id={`quadratic:${entry.id}`}
                >
                  <span class="db-problem-title">{entry.data.title}</span>
                  <span class="db-problem-meta">
                    <span class="db-problem-chip">重要度：{entry.data.importance_label}</span>
                    <span class="db-problem-chip">難易度：{entry.data.difficulty}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <ul class="db-problem-list" data-unit-panel="trig" hidden>
            {trigProblems.map((problem) => (
              <li>
                <button
                  type="button"
                  class="db-problem-item"
                  data-problem-id={`trig:${problem.slug}`}
                >
                  <span class="db-problem-title">{problem.title}</span>
                  <span class="db-problem-meta">
                    <span class="db-problem-chip db-problem-chip--sample">6問検証サンプル</span>
                    {problem.labels.slice(0, 2).map((label) => (
                      <span class="db-problem-chip">{label.name}：{label.value}</span>
                    ))}
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <ul class="db-problem-list" data-unit-panel="data-analysis" hidden>
            {dataAnalysisProblems.map((problem) => (
              <li>
                <button
                  type="button"
                  class="db-problem-item"
                  data-problem-id={`data-analysis:${problem.slug}`}
                >
                  <span class="db-problem-title">{problem.title}</span>
                  <span class="db-problem-meta">
                    <span class="db-problem-chip db-problem-chip--sample">6問検証サンプル</span>
                    {problem.labels.slice(0, 2).map((label) => (
                      <span class="db-problem-chip">{label.name}：{label.value}</span>
                    ))}
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <ul class="db-problem-list" data-unit-panel="probability" hidden>
            {probabilityProblems.map((problem) => (
              <li>
                <button
                  type="button"
                  class="db-problem-item"
                  data-problem-id={`probability:${problem.slug}`}
                >
                  <span class="db-problem-title">{problem.title}</span>
                  <span class="db-problem-meta">
                    <span class="db-problem-chip db-problem-chip--sample">6問検証サンプル</span>
                    {problem.labels.slice(0, 2).map((label) => (
                      <span class="db-problem-chip">{label.name}：{label.value}</span>
                    ))}
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <ul class="db-problem-list" data-unit-panel="geometry" hidden>
            {geometryProblems.map((problem) => (
              <li>
                <button
                  type="button"
                  class="db-problem-item"
                  data-problem-id={`geometry:${problem.slug}`}
                >
                  <span class="db-problem-title">{problem.title}</span>
                  <span class="db-problem-meta">
                    <span class="db-problem-chip db-problem-chip--sample">6問検証サンプル</span>
                    {problem.labels.slice(0, 2).map((label) => (
                      <span class="db-problem-chip">{label.name}：{label.value}</span>
                    ))}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </section>

        <section class="db-pane db-pane-detail" aria-label="選択中の問題の詳細">
          {sutoShikiProblems.map((problem) => (
            <div
              class="db-detail-panel"
              data-detail-panel={`suto-shiki:${problem.slug}`}
              hidden={`suto-shiki:${problem.slug}` !== DEFAULT_PROBLEM}
            >
              <SutoShikiDetail problem={problem} />
            </div>
          ))}
          {quadratic27Entries.map((prepared) => (
            <div
              class="db-detail-panel"
              data-detail-panel={`quadratic:${prepared.entry.id}`}
              hidden={`quadratic:${prepared.entry.id}` !== DEFAULT_PROBLEM}
            >
              <Quadratic27Detail prepared={prepared} />
            </div>
          ))}
          {trigProblems.map((problem) => (
            <div
              class="db-detail-panel"
              data-detail-panel={`trig:${problem.slug}`}
              hidden
            >
              <TrigProblemDetail problem={problem} />
            </div>
          ))}
          {dataAnalysisProblems.map((problem) => (
            <div
              class="db-detail-panel"
              data-detail-panel={`data-analysis:${problem.slug}`}
              hidden
            >
              <DataAnalysisDetail problem={problem} />
            </div>
          ))}
          {probabilityProblems.map((problem) => (
            <div
              class="db-detail-panel"
              data-detail-panel={`probability:${problem.slug}`}
              hidden
            >
              <ProbabilityDetail problem={problem} />
            </div>
          ))}
          {geometryProblems.map((problem) => (
            <div
              class="db-detail-panel"
              data-detail-panel={`geometry:${problem.slug}`}
              hidden
            >
              <MenelausDetail problem={problem} />
            </div>
          ))}
        </section>
      </div>
    </div>

    <script define:vars={{ unitMeta }}>
      const shell = document.querySelector('.db-shell');
      const currentPathEl = document.getElementById('db-current-path');
      // unitMetaはフロントマターでsubjectNavから動的に組み立てたもの。
      // 数学I決め打ちをやめ、単元IDから科目名・単元名の両方を引けるようにしている。

      function selectProblem(problemId) {
        document.querySelectorAll('.db-problem-item').forEach((btn) => {
          btn.classList.toggle('is-selected', btn.dataset.problemId === problemId);
        });
        document.querySelectorAll('.db-detail-panel').forEach((panel) => {
          panel.hidden = panel.dataset.detailPanel !== problemId;
        });

        const [unitId] = problemId.split(':');
        const titleEl = shell?.querySelector(
          `.db-problem-item[data-problem-id="${problemId}"] .db-problem-title`,
        );
        const title = titleEl?.textContent?.trim() ?? '';
        const meta = unitMeta[unitId];
        if (currentPathEl) {
          currentPathEl.textContent = `${meta?.subject ?? unitId} ＞ ${meta?.unit ?? unitId} ＞ ${title}`;
        }
      }

      function selectUnit(unitId) {
        document.querySelectorAll('.db-unit-btn').forEach((btn) => {
          const isSelected = btn.dataset.unitId === unitId;
          btn.classList.toggle('is-selected', isSelected);
          if (isSelected) {
            btn.setAttribute('aria-current', 'true');
          } else {
            btn.removeAttribute('aria-current');
          }
        });
        document.querySelectorAll('.db-problem-list').forEach((list) => {
          list.hidden = list.dataset.unitPanel !== unitId;
        });

        const firstItem = document.querySelector(
          `.db-problem-list[data-unit-panel="${unitId}"] .db-problem-item`,
        );
        if (firstItem?.dataset.problemId) {
          selectProblem(firstItem.dataset.problemId);
        }
      }

      document.querySelectorAll('.db-unit-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.dataset.unitId) selectUnit(btn.dataset.unitId);
        });
      });
      document.querySelectorAll('.db-problem-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.dataset.problemId) selectProblem(btn.dataset.problemId);
        });
      });
    </script>

    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }

      .db-shell {
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--color-bg);
      }

      .db-header {
        flex-shrink: 0;
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        padding: 0.55rem 1rem;
        background: var(--color-primary-dark);
        color: #fff;
      }
      .db-header-title {
        font-weight: 700;
        font-size: 1.05rem;
      }
      .db-current-path {
        margin-left: auto;
        font-size: 0.8rem;
        color: #d6e3ea;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .db-header-back {
        font-size: 0.8rem;
        color: #bcdff0;
        flex-shrink: 0;
        padding: 0.3rem 0.6rem;
        margin: -0.3rem -0.6rem -0.3rem 0;
        border-radius: var(--radius);
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .db-header-back:hover {
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        text-decoration: none;
      }
      .db-header-info {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-shrink: 0;
        padding-left: 0.8rem;
        border-left: 1px solid rgba(255, 255, 255, 0.25);
      }
      .db-header-info a {
        font-size: 0.75rem;
        color: #bcdff0;
      }
      .db-header-info a:hover {
        color: #fff;
        text-decoration: none;
      }

      .db-body {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 200px 300px 1fr;
      }

      .db-pane {
        min-height: 0;
        overflow-y: auto;
      }

      .db-pane-subjects {
        border-right: 1px solid var(--color-border);
        background: var(--color-surface);
        padding: 1rem 0.75rem;
      }
      .db-subject-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .db-subject {
        margin-bottom: 1rem;
      }
      .db-subject-name {
        display: block;
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-bottom: 0.35rem;
      }
      .db-unit-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .db-unit-btn {
        display: block;
        width: 100%;
        text-align: left;
        border: none;
        background: transparent;
        border-radius: var(--radius);
        padding: 0.4rem 0.6rem;
        margin-bottom: 0.15rem;
        font-size: 0.9rem;
        color: var(--color-text);
        cursor: pointer;
      }
      .db-unit-btn:hover {
        background: var(--color-accent-bg);
      }
      .db-unit-btn.is-selected {
        background: var(--color-primary);
        color: #fff;
        font-weight: 700;
      }
      .db-unit-placeholder {
        margin: 0 0 0 0.6rem;
        font-size: 0.85rem;
        color: var(--color-text-muted);
      }
      .db-subject-note {
        margin: 1rem 0 0;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .db-pane-list {
        border-right: 1px solid var(--color-border);
        background: var(--color-bg);
        padding: 0.9rem;
      }
      .db-problem-list {
        list-style: none;
        margin: 0 0 0.75rem;
        padding: 0;
      }
      .db-problem-item {
        display: block;
        width: 100%;
        text-align: left;
        border: 1px solid var(--color-border);
        border-left: 3px solid transparent;
        background: var(--color-surface);
        border-radius: var(--radius);
        padding: 0.55rem 0.7rem;
        margin-bottom: 0.5rem;
        cursor: pointer;
      }
      .db-problem-item:hover {
        border-color: var(--color-primary);
      }
      .db-problem-item.is-selected {
        border-left-color: var(--color-primary);
        border-color: var(--color-primary);
        background: var(--color-accent-bg);
      }
      .db-problem-title {
        display: block;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 0.3rem;
      }
      .db-problem-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }
      .db-problem-chip {
        font-size: 0.7rem;
        color: var(--color-text-muted);
        background: var(--color-accent-bg);
        border-radius: 4px;
        padding: 0.1rem 0.4rem;
      }
      .db-problem-item.is-selected .db-problem-chip {
        background: #fff;
      }
      .db-problem-chip--sample {
        color: var(--color-primary-dark);
        font-weight: 700;
        background: #fff;
        border: 1px solid var(--color-primary);
      }
      .db-list-note {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin: 0.5rem 0 0;
      }

      .db-pane-detail {
        background: var(--color-surface);
        padding: 1.5rem 1.75rem 3rem;
      }
      .db-pane-detail :global(h1) {
        margin-top: 0;
      }

      /* asset(SVG)は正本ファイルをそのまま挿入するため、右ペイン内への収まりだけ調整する。
         余白・.thinking-part等の共通スタイルはglobal.css側（M1-QF-001〜054共通）に集約した。 */
      .problem-asset-figure {
        max-width: 480px;
      }
      .problem-asset-figure :global(svg) {
        display: block;
        width: 100%;
        height: auto;
      }

      /* PCの3ペインをスマホへ無理に縮小しない。狭幅では単純に縦積みにする。 */
      @media (max-width: 900px) {
        .db-shell {
          height: auto;
          min-height: 100vh;
        }
        .db-body {
          grid-template-columns: 1fr;
        }
        .db-pane {
          overflow-y: visible;
        }
        .db-pane-subjects,
        .db-pane-list {
          border-right: none;
          border-bottom: 1px solid var(--color-border);
        }
        .db-current-path {
          display: none;
        }
      }
    </style>
  </body>
</html>
