---
import { getVerifiedCollection } from '../../utils/verifiedCollection';
import { prepareQuadratic27Entry } from '../../utils/prepareQuadratic27Entry';
import { buildQuadraticCenterItems } from '../../utils/quadraticDbItems';
import Quadratic27Detail from '../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../components/ProblemDbShell.astro';
import { getTypeNavItems } from '../../utils/typePages';

// /app/は問題データベースの正式な入口。現時点では数学I「二次関数」の最初の問題
// （M1-QF-001、display_order昇順で先頭）を初期選択した状態で3ペインDBを表示する。
// 表示内容の実体は/math1/quadratic/[slug]/と同じ prepareQuadratic27Entry +
// Quadratic27Detail を再利用し、教材データを二重管理しない。
const quadratic27 = (await getVerifiedCollection('quadratic27')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildQuadraticCenterItems(quadratic27);
const defaultEntry = quadratic27[0];
const prepared = await prepareQuadratic27Entry(defaultEntry);
// 中央列の「問題タイプ」一覧（初期タブは問題一覧。公開前は0件で切替自体を出さない）。
const typeItems = await getTypeNavItems('quadratic');
---

<ProblemDbShell
  title="問題データベース（試作） | 高校数学ナビ"
  description="高校数学ナビの問題データベースです。数学I「二次関数」など、単元ごとに問題を選んで解法の流れを確認できます。"
  canonicalPath="/app/"
  breadcrumbItems={[
    { label: '数学I' },
    { label: '二次関数', href: '/math1/quadratic/' },
    { label: defaultEntry.data.title },
  ]}
  activeUnitId="quadratic"
  activeItemId={defaultEntry.id}
  centerItems={centerItems}
  typeItems={typeItems}
  noindex
>
  <Quadratic27Detail prepared={prepared} />
</ProblemDbShell>
