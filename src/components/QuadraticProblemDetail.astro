---
import AnswerFlow from './AnswerFlow.astro';
import { starRating } from '../utils/stars';
import type { QuadraticProblem } from '../data/math1/quadratic';

interface Props {
  problem: QuadraticProblem;
}

const { problem } = Astro.props;
---

<h1>{problem.number}　{problem.title}</h1>

<section class="problem-section">
  <h2>問題</h2>
  <p>{problem.statementIntro}</p>
  <ul>
    {problem.statementItems.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="problem-meta-section">
  <h2>問題の位置づけ</h2>
  <p class="meta-line">
    重要度：{starRating(problem.importance)}　難易度：{starRating(problem.difficulty)}
  </p>
  <p class="note">{problem.note}</p>
</section>

<section class="answer-flow-section">
  <h2>解答フロー</h2>
  <AnswerFlow steps={problem.steps} />
</section>
