---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareCountingProbabilityEntry } from '../../../utils/prepareCountingProbabilityEntry';
import { buildCountingProbabilityCenterItems } from '../../../utils/countingProbabilityDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';
import type { CollectionEntry } from 'astro:content';

// 数学A「場合の数・確率」の個別問題ページ。数学Iの各単元の[slug].astroと同じ構成
// （静的生成・共通DBシェル再利用）をcountingProbabilityコレクションに対しても使う。
// 公開contract（index対象・sitemap掲載・canonicalは自身のURL）は数学Iの個別問題と同格。
// 生成対象は独立検算済みの問題だけ（getVerifiedCollection）。未検算の問題は、正本の
// verification_statusが更新されて再同期されるまで、ページも一覧項目も生成されない。
// 型ページはこの単元にはまだ無いため、問題routeだけを返す。
export async function getStaticPaths() {
  const problems = await getVerifiedCollection('countingProbability');
  return problems.map((problem) => ({
    params: { slug: problem.id },
    props: { problem },
  }));
}

type Props = { problem: CollectionEntry<'countingProbability'> };

const { problem } = Astro.props;
const prepared = await prepareCountingProbabilityEntry(problem);

const allProblems = (await getVerifiedCollection('countingProbability')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildCountingProbabilityCenterItems(allProblems);
---

<ProblemDbShell
  title={`${problem.data.title} | 数学A 場合の数・確率 | 高校数学ナビ`}
  description={`${problem.data.title}（重要度：${problem.data.importance_label}／難易度：${problem.data.difficulty}）。数学A「場合の数・確率」の問題データベースより、問題文・ThinkingFlow・最終解答を確認できます。`}
  canonicalPath={`/math-a/counting-probability/${problem.id}/`}
  breadcrumbItems={[
    { label: '数学A' },
    { label: '場合の数・確率', href: '/math-a/counting-probability/' },
    { label: problem.data.title },
  ]}
  activeUnitId="counting-probability"
  activeItemId={problem.id}
  centerItems={centerItems}
>
  <Quadratic27Detail prepared={prepared} />
</ProblemDbShell>
