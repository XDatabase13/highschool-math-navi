---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // トップページは説明・入口用ページのため、科目選択用の左サイドナビを出さない。
  // 科目選択は /app/（3ペインDB）側へ集約する。
  showNav?: boolean;
}

const DEFAULT_DESCRIPTION =
  '「何をやるか」「何を後回しにするか」を明確にするための高校数学ナビ（試作公開中）。';

const { title, description = DEFAULT_DESCRIPTION, showNav = true } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="app">
      <header class="site-header">
        <a class="site-title" href="/">高校数学ナビ</a>
      </header>
      <div class:list={['layout', !showNav && 'layout--no-nav']}>
        {showNav && <Nav />}
        <main class="main-content">
          <slot />
        </main>
      </div>
      <footer class="site-footer">
        <nav class="footer-links" aria-label="サイト情報">
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/contact/">お問い合わせ</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
