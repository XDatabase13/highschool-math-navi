---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // TOPページ限定のブランド表示・レイアウト幅調整。他のページ
  // （Privacy/Disclaimer/Contact/404）には波及させないためのオプトイン。
  largeBrand?: boolean;
  wideLayout?: boolean;
  // TOPページ限定の配色（Cool Paper × Digital Blue）。.app配下のCSS変数を
  // 上書きするだけなので、このクラスを持たない他ページは既存の配色のまま。
  topTheme?: boolean;
}

const DEFAULT_DESCRIPTION =
  '「何をやるか」「何を後回しにするか」を明確にするための高校数学ナビ（試作公開中）。';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  largeBrand = false,
  wideLayout = false,
  topTheme = false,
} = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <div class:list={['app', topTheme && 'top-theme']}>
      <header class="site-header">
        <a class:list={['site-title', largeBrand && 'site-title--top']} href="/">高校数学ナビ</a>
      </header>
      {/* 科目選択は /app/（3ペインDB）側へ集約し、BaseLayoutのページには左サイドナビを出さない
          （旧Nav.astroは2026-09-24に削除）。layout--no-navは1カラム幅のためのクラスとして常に付ける。 */}
      <div class:list={['layout', 'layout--no-nav', wideLayout && 'layout--wide']}>
        <main class="main-content">
          <slot />
        </main>
      </div>
      <footer class="site-footer">
        <nav class="footer-links" aria-label="サイト情報">
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/contact/">お問い合わせ</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
