---
import { starRating } from '../utils/stars';
import { flowAssetKey, parseStepTitle, verifyStepNumberMatchesIndex, type PreparedQuadratic27Entry } from '../utils/prepareQuadratic27Entry';

interface Props {
  prepared: PreparedQuadratic27Entry;
}

const { prepared } = Astro.props;
const { entry, problem, paraphrase, problemMeta, solutionMeta, thinkingFlow, finalAnswer, problemAssets, finalAnswerAssets, flowAssetsByKey } = prepared;
---

<div class="q27-detail">
<h1>{entry.data.title}</h1>

<ul class="label-list">
  <li class="label-item">
    <span class="label-name">重要度</span>
    <span class="label-value">{entry.data.importance_label}</span>
  </li>
  <li class="label-item">
    <span class="label-name">難易度</span>
    <span class="label-value">{starRating(entry.data.difficulty, 4)}</span>
  </li>
</ul>

{problem && (
  <section class="problem-section">
    <h2>問題</h2>
    <div set:html={problem.html} />
    {problem.subsections.length > 0 && (
      <div class="problem-parts">
        {problem.subsections.map((part) => (
          <div class="problem-part">
            <h3 class="problem-part-label">{part.title}</h3>
            <div set:html={part.html} />
          </div>
        ))}
      </div>
    )}
    {problemAssets.map(({ svg }) => (
      <figure class="problem-asset-figure" set:html={svg} />
    ))}
    {paraphrase && (
      <div class="paraphrase-box">
        <button type="button" class="paraphrase-toggle" data-paraphrase-toggle>
          言い換えを見る
        </button>
        <div class="paraphrase-content" data-paraphrase-content hidden>
          {paraphrase.subsections.length === 0 ? (
            <div set:html={paraphrase.html} />
          ) : (
            paraphrase.subsections.map((part) => (
              <div class="paraphrase-part">
                <h4 class="paraphrase-part-label">{part.title}</h4>
                <div set:html={part.html} />
              </div>
            ))
          )}
        </div>
      </div>
    )}
  </section>
)}

{(problemMeta || solutionMeta) && (
  <section class="impression-section">
    {problemMeta && (
      <>
        <h3 class="impression-subhead">問題メタ</h3>
        <div set:html={problemMeta.html} />
      </>
    )}
    {solutionMeta && (
      <>
        <h3 class="impression-subhead">解法メタ</h3>
        <div set:html={solutionMeta.html} />
      </>
    )}
  </section>
)}

{thinkingFlow && (
  <section class="thinking-section">
    <h2>ThinkingFlow</h2>
    {thinkingFlow.subsections.every((s) => s.subsections.length === 0) ? (
      // 通常Flow：見出しがそのまま末端ステップ
      // data-flow-kind="q27"：ThinkingFlow.astroの汎用スクリプトと二重に
      // click handlerが付かないよう、このコンポーネント専用スクリプトの対象を区別する。
      <div class="thinking-flow" data-flow-kind="q27">
        <button type="button" class="reveal-all-btn" data-reveal-all>
          考え方を全部見る
        </button>
        <ol class="thinking-steps">
          {thinkingFlow.subsections.map((step, index) => {
            verifyStepNumberMatchesIndex(entry.data.problem_id, '通常Flow', step.title, index + 1);
            const { displayTitle, highlighted } = parseStepTitle(step.title);
            return (
              <li
                class:list={['thinking-step', highlighted && 'thinking-step--highlight']}
                data-step-index={index}
              >
                <button type="button" class="thinking-step-header thinking-step-toggle" data-step-toggle aria-expanded="false">
                  <span class="thinking-step-label">{displayTitle}</span>
                  {highlighted && <span class="thinking-step-star" aria-hidden="true">★</span>}
                  <span class="thinking-step-caret" aria-hidden="true" />
                </button>
                <div class="thinking-step-content" data-step-content hidden>
                  <div class="thinking-step-content-inner">
                    <div class="thinking-step-body" set:html={step.html} />
                    {(flowAssetsByKey.get(flowAssetKey(undefined, index + 1)) ?? []).map(({ svg }) => (
                      <figure class="problem-asset-figure" set:html={svg} />
                    ))}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ) : (
      // 小問付きFlow：(1)/(2)ごとに独立した.thinking-flowを並べる。
      thinkingFlow.subsections.map((part) => (
        <div class="thinking-part">
          <h3 class="thinking-part-label">{part.title}</h3>
          <div class="thinking-flow" data-flow-kind="q27">
            <button type="button" class="reveal-all-btn" data-reveal-all>
              考え方を全部見る
            </button>
            <ol class="thinking-steps">
              {part.subsections.map((step, index) => {
                verifyStepNumberMatchesIndex(
                  entry.data.problem_id,
                  `小問Flow ${part.title}`,
                  step.title,
                  index + 1,
                );
                const { displayTitle, highlighted } = parseStepTitle(step.title);
                return (
                  <li
                    class:list={['thinking-step', highlighted && 'thinking-step--highlight']}
                    data-step-index={index}
                  >
                    <button type="button" class="thinking-step-header thinking-step-toggle" data-step-toggle aria-expanded="false">
                      <span class="thinking-step-label">{displayTitle}</span>
                      {highlighted && <span class="thinking-step-star" aria-hidden="true">★</span>}
                      <span class="thinking-step-caret" aria-hidden="true" />
                    </button>
                    <div class="thinking-step-content" data-step-content hidden>
                      <div class="thinking-step-content-inner">
                        <div class="thinking-step-body" set:html={step.html} />
                        {(flowAssetsByKey.get(flowAssetKey(part.partNumber, index + 1)) ?? []).map(({ svg }) => (
                          <figure class="problem-asset-figure" set:html={svg} />
                        ))}
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        </div>
      ))
    )}
  </section>
)}

{finalAnswer && (
  <section class="final-answer-section">
    <h2>最終解答</h2>
    <button type="button" class="reveal-answer-btn" data-answer-toggle>
      解答を見る
    </button>
    <div class="result-box" data-answer-box hidden>
      <div class="result-box-inner">
        {finalAnswer.subsections.length === 0 ? (
          <div set:html={finalAnswer.html} />
        ) : (
          finalAnswer.subsections.map((part) => (
            <div class="final-answer-part">
              <h3 class="final-answer-part-label">{part.title}</h3>
              <div set:html={part.html} />
            </div>
          ))
        )}
        {finalAnswerAssets.map(({ svg }) => (
          <figure class="problem-asset-figure" set:html={svg} />
        ))}
      </div>
    </div>
  </section>
)}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.thinking-flow[data-flow-kind="q27"]').forEach((flow) => {
    if (flow.dataset.q27Bound) return;
    flow.dataset.q27Bound = 'true';

    const stepEls = Array.from(flow.querySelectorAll<HTMLElement>('.thinking-step'));
    const revealAllBtn = flow.querySelector<HTMLButtonElement>('[data-reveal-all]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 閉じるアニメーション(CSS側は150〜200ms)が終わってからhiddenへ戻すための
    // 予約タイマー。連続操作で開閉し直された場合に備え、要素ごとに保持し
    // 前回分は必ずclearしてから次の状態へ進む。
    const closeTimers = new WeakMap<HTMLElement, number>();

    // 各Flowは題名のみの初期状態から独立して開閉できる。「考え方を全部見る」は
    // 全Flow展開⇔全Flow閉じるのトグルとして扱う。
    function setStepExpanded(stepEl: HTMLElement, expanded: boolean) {
      const toggle = stepEl.querySelector<HTMLButtonElement>('[data-step-toggle]');
      const content = stepEl.querySelector<HTMLElement>('[data-step-content]');
      if (toggle) toggle.setAttribute('aria-expanded', String(expanded));
      if (!content) return;

      const pendingTimer = closeTimers.get(content);
      if (pendingTimer !== undefined) {
        window.clearTimeout(pendingTimer);
        closeTimers.delete(content);
      }

      if (expanded) {
        content.hidden = false;
        if (prefersReducedMotion) {
          content.classList.add('is-open');
          return;
        }
        // hiddenを外した直後は:not([hidden])の初期値（0fr/opacity:0）。
        // レイアウトを一度強制確定させてからis-openを付けることで、
        // バックグラウンドタブ等でrequestAnimationFrameが遅延・停止する
        // 環境でも確実にトランジションの起点が反映される。
        void content.offsetHeight;
        content.classList.add('is-open');
      } else {
        content.classList.remove('is-open');
        if (prefersReducedMotion) {
          content.hidden = true;
          return;
        }
        // CSS側の最大想定（200ms）より少し余裕を持たせ、確実に収縮し終えてから
        // hiddenに戻す（開閉ロジック・最終状態自体は変更しない）。
        const timerId = window.setTimeout(() => {
          content.hidden = true;
          closeTimers.delete(content);
        }, 220);
        closeTimers.set(content, timerId);
      }
    }

    function updateRevealAllLabel() {
      if (!revealAllBtn) return;
      const allExpanded = stepEls.every((stepEl) => {
        const toggle = stepEl.querySelector<HTMLButtonElement>('[data-step-toggle]');
        return toggle ? toggle.getAttribute('aria-expanded') === 'true' : true;
      });
      revealAllBtn.textContent = allExpanded ? '考え方を閉じる' : '考え方を全部見る';
    }

    flow.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      const stepToggle = target.closest<HTMLButtonElement>('[data-step-toggle]');
      if (stepToggle) {
        const stepEl = stepToggle.closest<HTMLElement>('.thinking-step');
        if (stepEl) {
          const isExpanded = stepToggle.getAttribute('aria-expanded') === 'true';
          setStepExpanded(stepEl, !isExpanded);
          updateRevealAllLabel();
        }
        return;
      }

      const revealBtn = target.closest<HTMLButtonElement>('[data-reveal-all]');
      if (revealBtn) {
        const allExpanded = stepEls.every((stepEl) => {
          const toggle = stepEl.querySelector<HTMLButtonElement>('[data-step-toggle]');
          return toggle ? toggle.getAttribute('aria-expanded') === 'true' : true;
        });
        stepEls.forEach((stepEl) => setStepExpanded(stepEl, !allExpanded));
        updateRevealAllLabel();
      }
    });

    updateRevealAllLabel();
  });

  // 最終解答の開閉も、ThinkingFlowの各STEPと同じ手法（grid-template-rowsの
  // 0fr/1fr切り替え）でアニメーションさせる。開閉ロジック・最終状態は変更しない。
  document.querySelectorAll<HTMLElement>('[data-answer-toggle]').forEach((btn) => {
    if (btn.dataset.answerBound) return;
    btn.dataset.answerBound = 'true';
    const box = btn.parentElement?.querySelector<HTMLElement>('[data-answer-box]');
    if (!box) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let closeTimer: number | undefined;

    btn.addEventListener('click', () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }

      const isHidden = box.hasAttribute('hidden');
      if (isHidden) {
        box.hidden = false;
        btn.textContent = '解答を隠す';
        if (prefersReducedMotion) {
          box.classList.add('is-open');
          return;
        }
        // hiddenを外した直後はCSS側の閉状態（0fr/opacity:0）。
        // 強制的にレイアウトを確定させてからis-openを付けることで
        // そこから滑らかにアニメーションする（rAFに頼らない）。
        void box.offsetHeight;
        box.classList.add('is-open');
      } else {
        box.classList.remove('is-open');
        btn.textContent = '解答を見る';
        if (prefersReducedMotion) {
          box.hidden = true;
          return;
        }
        // CSS側の閉アニメーション（150〜180ms）より少し余裕を持たせてからhiddenに戻す。
        closeTimer = window.setTimeout(() => {
          box.hidden = true;
          closeTimer = undefined;
        }, 200);
      }
    });
  });

  document.querySelectorAll<HTMLElement>('[data-paraphrase-toggle]').forEach((btn) => {
    if (btn.dataset.paraphraseBound) return;
    btn.dataset.paraphraseBound = 'true';
    const box = btn.parentElement?.querySelector<HTMLElement>('[data-paraphrase-content]');
    btn.addEventListener('click', () => {
      const isHidden = box?.hasAttribute('hidden') ?? false;
      box?.toggleAttribute('hidden');
      btn.textContent = isHidden ? '言い換えを閉じる' : '言い換えを見る';
    });
  });
</script>
