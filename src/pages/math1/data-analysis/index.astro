---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareDataAnalysisEntry } from '../../../utils/prepareDataAnalysisEntry';
import { buildDataAnalysisCenterItems } from '../../../utils/dataAnalysisDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';

// データの分析単元トップ。既存の共通3ペインDB UI（ProblemDbShell + Quadratic27Detail）を
// QF/TRとそのまま共有する。本番公開契約へ昇格済みのため、QF/TRと同様にindex対象・
// sitemap掲載とする（noindexは外す。AGENTS.md「データの分析の現在地」参照）。
const dataAnalysis = (await getVerifiedCollection('dataAnalysis')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildDataAnalysisCenterItems(dataAnalysis);
const defaultEntry = dataAnalysis[0];
const prepared = await prepareDataAnalysisEntry(defaultEntry);
---

<ProblemDbShell
  title="数学I データの分析 | 高校数学ナビ"
  description="数学I「データの分析」の問題データベースです。代表値と度数分布、四分位数と箱ひげ図、分散と標準偏差、散布図と相関、仮説検定まで、全23問を収録しています。"
  canonicalPath="/math1/data-analysis/"
  breadcrumb={`数学I ＞ データの分析 ＞ ${defaultEntry.data.title}`}
  activeUnitId="data-analysis"
  activeItemId={defaultEntry.id}
  centerItems={centerItems}
>
  <Quadratic27Detail prepared={prepared} />
</ProblemDbShell>
