---
import { getVerifiedCollection } from '../../../utils/verifiedCollection';
import { prepareExpressionCalculationEntry } from '../../../utils/prepareExpressionCalculationEntry';
import { buildExpressionCalculationCenterItems } from '../../../utils/expressionCalculationDbItems';
import Quadratic27Detail from '../../../components/Quadratic27Detail.astro';
import ProblemDbShell from '../../../components/ProblemDbShell.astro';

// 数と式「式の計算」単元トップ。既存の共通3ペインDB UI（ProblemDbShell + Quadratic27Detail）を
// QF/TR/DAとそのまま共有する。QF/TR/DAと同格の公開contract（index対象・sitemap掲載・
// canonicalは自身のURL）とする。
const expressionCalculation = (await getVerifiedCollection('expressionCalculation')).sort(
  (a, b) => a.data.display_order - b.data.display_order,
);
const centerItems = buildExpressionCalculationCenterItems(expressionCalculation);
const defaultEntry = expressionCalculation[0];
const prepared = await prepareExpressionCalculationEntry(defaultEntry);
---

<ProblemDbShell
  title="数学I 数と式 | 高校数学ナビ"
  description="数学I「数と式」の問題データベースです。式の計算（単項式・多項式の係数・次数・整理）を収録しています。"
  canonicalPath="/math1/suto-shiki/"
  breadcrumbItems={[{ label: '数学I' }, { label: '数と式' }]}
  activeUnitId="suto-shiki"
  activeItemId={defaultEntry.id}
  centerItems={centerItems}
>
  <Quadratic27Detail prepared={prepared} unitHeading="数学I 数と式" />
</ProblemDbShell>
